<!--
  local_planner_agx.launch, expanded inline (not `<include>`d) so this file
  can do two things that launch can't otherwise reach:

  1. Remap pathFollower's cmd_vel output away from the real topic.
     pathFollower runs its control loop continuously and publishes to
     `/cmd_vel` at ~27 Hz REGARDLESS of whether a goal is active — confirmed
     live, it was still streaming zero-velocity Twists with no goal in
     progress at all. A single teleop publish from adapter_ros1 competing
     against that gets overwritten within tens of milliseconds; asserting
     `/stop` (the nav_stop topic) makes pathFollower's own commanded value
     zero but does NOT stop it from publishing, so it doesn't fix the race
     either. mist_ws's own launch file anticipated exactly this (a
     commented-out `<remap from="/cmd_vel" to="/cmd_vel_mux_local_planner"/>`,
     never finished) — adapter_ros1 subscribes `/cmd_vel_nav` here and relays
     it to the real `/cmd_vel` ONLY while nav_status is "active" (see
     HardwareBridge._on_nav_cmd_vel), so pathFollower's continuous idle
     publishing never reaches the real topic, and teleop never races it.

  2. Set autonomyMode:=true. Confirmed live: with the default `false`,
     pathFollower's linear speed is gated entirely by `joySpeed`, which is
     ONLY ever set from a joystick's throttle axis or a /speed publisher —
     neither exists here — so it stays permanently zero. `/path` was
     computing fine (10 Hz, real candidate trajectories) and `/cmd_vel_nav`
     stayed all-zero regardless: not a wiring bug, a launch parameter. With
     autonomyMode true, pathFollower drives joySpeed from goal distance
     directly (pathFollower.cpp, the `if (autonomyMode) { goaldis = ... }`
     block) and the result is still rescaled against `maxSpeed` (0.4 m/s)
     before publishing — the speed cap holds either way.
     `local_planner_agx.launch` doesn't expose this arg through its
     `<include>`, hence expanding it here rather than passing an override in.
-->
<launch>
    <arg name="robot_id" default="$(env ROBOT_ID)"/>
    <arg name="frame" default="LOCAL"/>

    <remap from="/cmd_vel" to="/cmd_vel_nav"/>

    <include file="$(find local_planner)/launch/local_planner_agx_scout.launch">
        <arg name="frame" value="$(arg frame)"/>
        <!-- See the file header: autonomyMode true switches the GOAL SOURCE to
             RelativeSetPointX/Y (via /setpoint_position/local), NOT goalX/goalY
             (via /move_base_simple/goal) - confirmed live, it silently ignores
             our goal and reports goalReached immediately. Left false: the path
             IS computed correctly toward our goal this way, it just needs a
             speed source that isn't a joystick - see fleet-status.md. -->
        <arg name="autonomyMode" value="false"/>
        <!-- The REAL footprint (0.62 x 0.585 m, per
             adapters/adapter_ros1/config/scout_mini.yaml), NOT an inflated one.
             These are read only by the checkRotObstacle branch
             (localPlanner.cpp:1008), and that branch first REJECTS every point
             falling INSIDE the rectangle as a self-return. Inflating the box
             therefore adds no clearance, it deletes real obstacles: the
             previous 0.99 x 0.99 ignored everything inside 0.495 m while
             flagging points out to 0.70 m, which once checkRotObstacle is on
             would stop the robot rotating almost anywhere. It also did nothing
             at all before now, because the only branch that reads it was
             disabled. -->
        <arg name="vehicleLength" value="0.62"/>
        <arg name="vehicleWidth" value="0.585"/>

        <!-- Guard the in-place rotation sweep. Scout Mini is skid-steer: it
             turns about its centre and sweeps its full 0.43 m circumscribed
             radius, but with this false (the mist_ws default) lines 1065 and
             1114 short-circuit on `|| !checkRotObstacle` and NOTHING checks
             that sweep, so a corner can sit clear of the chosen forward path
             and still be struck on the way round. Enabling it also makes
             vehicleLength/vehicleWidth above load-bearing for the first time.
             PARTIAL FIX: localPlanner.cpp:193 hard-codes a `dis > 0.4`
             near-field crop, so this guard can only ever see the 0.400..0.426 m
             annulus, i.e. it fires just before contact rather than early.
             Widening it means lowering that crop, which needs a mist_ws
             rebuild and so is deliberately not done here. -->
        <arg name="checkRotObstacle" value="true"/>

        <!-- Pin pathScale so the fallback loop cannot shrink the collision
             envelope back below the body. When no candidate path is clear,
             localPlanner.cpp:1149 shrinks pathScale by pathScaleStep (0.2) and
             retries; at the mist_ws floor of 0.5 that meant retrying with a
             0.225 m clearance radius on a robot of radius 0.43 m. At 0.75 the
             loop's own guard (`pathScale >= minPathScale + pathScaleStep`) is
             never satisfied, so pathScale stays pinned at the 0.75 that
             nav_joy_throttle sets and the footprint never shrinks; the loop
             gives up range instead, which is the safe thing to trade. -->
        <arg name="minPathScale" value="0.75"/>

        <!-- mist_ws ships 15; localPlanner's own default is 2. A candidate path
             counts as CLEAR unless at least this many obstacle points land in
             its envelope (localPlanner.cpp:1058), and the cloud reaching that
             test has already been 5 cm voxel-downsampled AND stripped of ~86%
             of its points by the minRelZ/maxRelZ height band (measured live:
             4572 of 32531 survive). A corner or a thin post presents a small
             angular cross-section and routinely produced fewer than 15
             surviving points, i.e. it read as clear. 10 rather than the stock 2
             keeps some immunity to stray floor returns, which matter here
             because the lidar mount is pitched about 2.5 deg. -->
        <arg name="pointPerPathThre" value="10"/>

        <!-- pathFollower steers with `vehicleYawRate = UY / trackingSlackLength`
             (pathFollower.cpp:559) and its entire forward/reverse hysteresis
             (navFwd / switchTime) is commented out, so there is NOTHING damping
             this loop: the sign and magnitude of the yaw command follow the
             selected path instantly, every cycle. At the compiled-in 0.2 m
             (pathFollower.cpp:78, never set by any launch until now) a lateral
             velocity above 0.157 m/s already saturates maxYawRate, so on any
             real turn the steering runs bang-bang and left/right chatter in the
             planner's path choice is reproduced directly as physical
             back-and-forth. 0.4 m keeps it in the proportional region for the
             whole 0..0.4 m/s speed range. Costs slightly wider arcs, which is
             the safe direction to err given the clearance work above. -->
        <arg name="trackingSlackLength" value="0.4"/>
    </include>

    <include file="$(find loam_interface)/launch/loam_interface.launch">
        <arg name="stateEstimationTopic" value="/odometry/filtered"/>
        <arg name="registeredScanTopic" value="/os_cloud_node/points"/>
        <arg name="frame" value="$(arg frame)"/>
    </include>
</launch>
