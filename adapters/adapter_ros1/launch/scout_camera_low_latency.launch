<launch>
  <!--
    Operator camera profile for the Scout Mini's RealSense D435i.

    Colour and depth both run, but they are NOT synchronised. On tars the
    camera is USB 2.1: the vendor 640x480@30 color+depth+point-cloud launch
    queues frames until they are a second late, and `enable_sync`/`align_depth`
    make colour wait for the slower depth stream. Teleop needs the colour
    topic to publish as soon as a frame exists. Depth is sampled later, at
    detector rate, by joining a colour bbox to this unaligned depth image
    through TF (see scout_mini.yaml `camera_color_info`).

    Depth stays enabled for map pins but is not aligned or synced, so colour
    never waits for it. 424x240 is not a valid mode on this USB 2.1 D435i
    (the driver falls back to 640x480@15); request that profile explicitly.
    Point-cloud generation stays off; mapping still comes from Ouster/LVI-SAM.
  -->
  <arg name="camera" default="d400_arm"/>
  <arg name="color_width" default="640"/>
  <arg name="color_height" default="480"/>
  <arg name="color_fps" default="10"/>
  <arg name="depth_width" default="640"/>
  <arg name="depth_height" default="480"/>
  <arg name="depth_fps" default="10"/>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="$(arg camera)"/>
    <arg name="tf_prefix" value="$(arg camera)"/>
    <arg name="device_type" value="d4.5"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="depth_width" value="$(arg depth_width)"/>
    <arg name="depth_height" value="$(arg depth_height)"/>
    <arg name="depth_fps" value="$(arg depth_fps)"/>
    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="true"/>
    <arg name="enable_infra" value="false"/>
    <arg name="enable_infra1" value="false"/>
    <arg name="enable_infra2" value="false"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
    <arg name="enable_pointcloud" value="false"/>
    <arg name="enable_sync" value="false"/>
    <arg name="align_depth" value="false"/>
    <arg name="filters" value=""/>
  </include>

  <!-- The robot URDF already calibrates chassis_link -> realsense_d435_link;
       the driver owns d400_arm_link -> optical frames. Join those two existing
       trees using the identity mount transform used by MIST's D400 launch. -->
  <node pkg="tf" type="static_transform_publisher" name="swarmdeck_d400_mount"
        args="0 0 0 0 0 0 realsense_d435_link d400_arm_link 100"/>
</launch>
