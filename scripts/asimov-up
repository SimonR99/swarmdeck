#!/usr/bin/env bash
# ==============================================================================
# SwarmDeck Asimov (Unitree G1) Bring-Up Script (scripts/asimov-up)
# ==============================================================================
#
# Starts Asimov's host-side Unitree G1 ROS 2 bridge (Foxy) and its SwarmDeck
# Docker Compose services (adapter, media streaming).
# Runs on the operator workstation and performs bring-up over SSH.
#
# Examples:
#   ./scripts/asimov-up                      # Standard bring-up (reset + start)
#   ./scripts/asimov-up --dry-run            # Inspect commands without executing
#   ./scripts/asimov-up --status             # Check running bridge and containers
#   ./scripts/asimov-up --down               # Stop bridge and containers
#   ./scripts/asimov-up --no-native-reset    # Keep existing native bridge running
# ==============================================================================

set -Eeuo pipefail

operator_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "${operator_repo}/deploy/fleet.env" ]]; then
  # shellcheck disable=SC1091
  source "${operator_repo}/deploy/fleet.env"
fi

# Configuration defaults
asimov_host="${DEPLOY_SSH_HOST:-asimov}"
asimov_repo="${DEPLOY_REMOTE_REPO:-/home/unitree/swarmdeck}"
compose_file="${DEPLOY_COMPOSE_FILE:-deploy/compose/docker-compose.robot-asimov.yml}"
robot_id="${DEPLOY_ROBOT_ID:-asimov_0}"
backend_host="${BACKEND_HOST:-192.168.1.161}"
backend_port="${BACKEND_PORT:-8080}"
asimov_workspace="${ASIMOV_WORKSPACE:-/home/unitree/workspaces}"
ros_domain="${ASIMOV_ROS_DOMAIN_ID:-0}"
unitree_iface="${ASIMOV_INTERFACE:-eth0}"
native_ws="${ASIMOV_ROS_WORKSPACE:-/home/unitree/workspaces/unitree_g1_ros2}"
native_log="${ASIMOV_NATIVE_LOG:-/tmp/swarmdeck-asimov-g1-bridge.log}"
native_reset="${ASIMOV_NATIVE_RESET:-yes}"
container_reset="${ASIMOV_CONTAINER_RESET:-yes}"
action="up"

usage() {
  cat <<'EOF'
SwarmDeck Asimov (Unitree G1) Bring-Up (scripts/asimov-up)

Usage:
  scripts/asimov-up [options]

Lifecycle Actions:
  (default)           Start native G1 bridge, odom bridge, and Compose services
  --down, --stop      Stop native G1 bridge and remove Compose containers
  --status            Check status of native processes, ports, and containers
  --dry-run           Print connection details and commands without executing
  -h, --help          Show this help message

Options:
  --host <ssh_host>   Target SSH host/alias (default: $DEPLOY_SSH_HOST or 'asimov')
  --no-native-reset   Do not restart native ROS 2 Foxy bridge if already running
  --no-container-reset
                      Do not recreate Docker containers (preserve running stack)
  --backend-host <ip> SwarmDeck backend IP (default: $BACKEND_HOST)
  --backend-port <p>  SwarmDeck backend port (default: $BACKEND_PORT or 8080)

Environment Variables:
  DEPLOY_SSH_HOST, DEPLOY_REMOTE_REPO, DEPLOY_COMPOSE_FILE, DEPLOY_ROBOT_ID,
  BACKEND_HOST, BACKEND_PORT, ASIMOV_INTERFACE, ASIMOV_ROS_DOMAIN_ID
EOF
  exit 0
}

# Parse CLI options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --down|--stop)
      action="down"
      shift
      ;;
    --status)
      action="status"
      shift
      ;;
    --dry-run)
      action="dry-run"
      shift
      ;;
    --host)
      asimov_host="$2"
      shift 2
      ;;
    --backend-host)
      backend_host="$2"
      shift 2
      ;;
    --backend-port)
      backend_port="$2"
      shift 2
      ;;
    --no-native-reset)
      native_reset="no"
      shift
      ;;
    --no-container-reset)
      container_reset="no"
      shift
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      echo "Run 'scripts/asimov-up --help' for usage." >&2
      exit 2
      ;;
  esac
done

case "$native_reset" in
  yes|no) ;;
  *) echo "Error: ASIMOV_NATIVE_RESET must be yes or no (got '$native_reset')" >&2; exit 2 ;;
esac
case "$container_reset" in
  yes|no) ;;
  *) echo "Error: ASIMOV_CONTAINER_RESET must be yes or no (got '$container_reset')" >&2; exit 2 ;;
esac

if [[ "$action" == "dry-run" ]]; then
  cat <<EOF
Asimov Bring-Up Configuration (Dry Run):
----------------------------------------
Target Host:        ${asimov_host}
Remote Repo:        ${asimov_repo}
Compose File:       ${compose_file}
Robot ID:           ${robot_id}
Backend Host:       ${backend_host}:${backend_port}
ROS Domain:         ${ros_domain}
Network Interface:  ${unitree_iface}
Native Workspace:   ${native_ws}
Native Reset:       ${native_reset}
Container Reset:    ${container_reset}
Action:             ${action}
EOF
  exit 0
fi

echo "Connecting to ${asimov_host} (action: ${action}, robot: ${robot_id})..."

ssh \
  -o ConnectTimeout=8 \
  -o BatchMode=yes \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  "$asimov_host" bash --noprofile --norc -s -- \
  "$asimov_repo" \
  "$compose_file" \
  "$robot_id" \
  "$backend_host" \
  "$backend_port" \
  "$asimov_workspace" \
  "$ros_domain" \
  "$unitree_iface" \
  "$native_ws" \
  "$native_log" \
  "$native_reset" \
  "$container_reset" \
  "$action" <<'REMOTE_SCRIPT'
set -Eeuo pipefail

repo=$1
compose_file=$2
robot_id=$3
backend_host=$4
backend_port=$5
asimov_workspace=$6
ros_domain=$7
unitree_iface=$8
native_ws=$9
native_log=${10}
native_reset=${11:-yes}
container_reset=${12:-yes}
action=${13:-up}

native_pid_file="${repo}/.deploy/asimov-native.pid"
odom_pid_file="${repo}/.deploy/asimov-odom.pid"
odom_log="${native_log%.log}-odom.log"
mkdir -p "${repo}/.deploy"

# The bridge package is installed on Asimov in a Foxy workspace. Nounset has to
# be disabled only while sourcing ROS setup hooks; the rest of this script stays
# strict so a partial bring-up cannot be reported as ready.
set +u
source /opt/ros/foxy/setup.bash
source "${native_ws}/install/setup.bash"
set -u
export ROS_DOMAIN_ID="${ros_domain}"
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export G1_INTERFACE="${unitree_iface}"

native_pids() {
  local pid pid_file
  for pid_file in "${native_pid_file}" "${odom_pid_file}"; do
    if [[ -r "${pid_file}" ]]; then
      read -r pid <"${pid_file}" || true
      if [[ "${pid:-}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null; then
        echo "${pid}"
      fi
    fi
  done
  # Catch a bridge started by hand before this deployment created its pid file.
  pgrep -f '[r]os2 launch g1_ros2_bridge robot.launch.py' || true
  pgrep -f '[a]simov_odom_bridge.py' || true
}

compose=(docker compose --project-name swarmdeck)
if [[ -f "${repo}/.deploy/asimov.env" ]]; then
  compose+=(--env-file "${repo}/.deploy/asimov.env")
fi
compose+=(-f "${repo}/${compose_file}")

stop_native() {
  local -a pids=()
  mapfile -t pids < <(native_pids | sort -nu)
  if ((${#pids[@]} == 0)); then
    echo "Native G1 bridge: not running"
    rm -f -- "${native_pid_file}"
    rm -f -- "${odom_pid_file}"
    return
  fi

  echo "Stopping native G1 bridge (PIDs: ${pids[*]})..."
  kill -INT "${pids[@]}" 2>/dev/null || true
  local attempt
  for attempt in {1..15}; do
    mapfile -t pids < <(native_pids | sort -nu)
    ((${#pids[@]} == 0)) && break
    sleep 1
  done
  if ((${#pids[@]} != 0)); then
    echo "Native G1 bridge did not stop after SIGINT; sending SIGTERM..." >&2
    kill -TERM "${pids[@]}" 2>/dev/null || true
    for attempt in {1..10}; do
      mapfile -t pids < <(native_pids | sort -nu)
      ((${#pids[@]} == 0)) && break
      sleep 1
    done
  fi
  if ((${#pids[@]} != 0)); then
    echo "Native G1 bridge is still running: ${pids[*]}" >&2
    return 1
  fi
  rm -f -- "${native_pid_file}"
  rm -f -- "${odom_pid_file}"
}

# --- Action: Status ---
if [[ "${action}" == "status" ]]; then
  echo "=== Asimov Native Services ==="
  mapfile -t pids < <(native_pids | sort -nu)
  if ((${#pids[@]} > 0)); then
    echo "Native G1 bridge running (PIDs: ${pids[*]})"
  else
    echo "Native G1 bridge: not running"
  fi
  echo ""
  echo "=== Asimov Containers ==="
  "${compose[@]}" --profile '*' ps --all
  exit 0
fi

# --- Action: Down ---
if [[ "${action}" == "down" || "${action}" == "stop" ]]; then
  echo "Stopping Asimov stack..."
  stop_native
  echo "Stopping Compose containers..."
  "${compose[@]}" --profile '*' down --remove-orphans
  echo "Asimov stack stopped."
  exit 0
fi

# --- Action: Up ---
if [[ "${native_reset}" == yes ]]; then
  stop_native
fi

start_native() {
  local -a pids=()
  mapfile -t pids < <(native_pids | sort -nu)
  if ((${#pids[@]} != 0)); then
    echo "Native G1 bridge: already running (PIDs: ${pids[*]})"
    return
  fi

  echo "Starting native G1 bridge on ${unitree_iface}..."
  nohup bash -c '
    set +u
    source /opt/ros/foxy/setup.bash
    source "$1/install/setup.bash"
    set -u
    export ROS_DOMAIN_ID="$2"
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export G1_INTERFACE="$3"
    exec ros2 launch g1_ros2_bridge robot.launch.py \
      interface:="$3" \
      domain_id:="$2" \
      enable_odom:=false \
      enable_cmd_vel:=true \
      enable_loco:=true \
      enable_description:=true \
      enable_camera:=false \
      require_enable:=false \
      dry_run:=false \
      quiet:=true
  ' swarmdeck-asimov-native "${native_ws}" "${ros_domain}" "${unitree_iface}" \
    >"${native_log}" 2>&1 < /dev/null &
  local pid=$!
  echo "${pid}" >"${native_pid_file}"
  sleep 2
  if ! kill -0 "${pid}" 2>/dev/null; then
    echo "Native G1 bridge exited during startup; recent log:" >&2
    tail -n 60 "${native_log}" >&2 || true
    return 1
  fi
  echo "Native G1 bridge started (log: ${native_log})"
}

start_odom() {
  local -a pids=()
  mapfile -t pids < <(native_pids | sort -nu | while read -r pid; do
    if tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null | grep -Fq 'asimov_odom_bridge.py'; then
      echo "${pid}"
    fi
  done)
  if ((${#pids[@]} != 0)); then
    echo "Asimov odometry bridge: already running (PIDs: ${pids[*]})"
    return
  fi

  echo "Starting Asimov odometry bridge on ${unitree_iface}..."
  nohup bash -c '
    set +u
    source /opt/ros/foxy/setup.bash
    source "$2/install/setup.bash"
    set -u
    export ROS_DOMAIN_ID="$3"
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export G1_INTERFACE="$4"
    exec /usr/bin/python3 "$1/adapters/adapter_ros2/asimov_odom_bridge.py"
  ' swarmdeck-asimov-odom "${repo}" "${native_ws}" "${ros_domain}" "${unitree_iface}" \
    >"${odom_log}" 2>&1 < /dev/null &
  local pid=$!
  echo "${pid}" >"${odom_pid_file}"
  sleep 2
  if ! kill -0 "${pid}" 2>/dev/null; then
    echo "Asimov odometry bridge exited during startup; recent log:" >&2
    tail -n 60 "${odom_log}" >&2 || true
    return 1
  fi
  echo "Asimov odometry bridge started (log: ${odom_log})"
}

start_native
start_odom

echo "Refreshing Compose containers for ${robot_id}..."
if [[ "${container_reset}" == yes ]]; then
  "${compose[@]}" --profile '*' down --remove-orphans
fi
"${compose[@]}" up -d --remove-orphans

require_service() {
  local name=$1 label=$2 attempt
  for attempt in {1..30}; do
    if ros2 service list 2>/dev/null | grep -Fxq "${name}"; then
      echo "${label}: available (${name})"
      return
    fi
    sleep 1
  done
  echo "${label} did not become available at ${name}" >&2
  return 1
}

require_topic() {
  local name=$1 label=$2 attempt
  for attempt in {1..30}; do
    if ros2 topic list 2>/dev/null | grep -Fxq "${name}"; then
      echo "${label}: publishing (${name})"
      return
    fi
    sleep 1
  done
  echo "${label} did not publish on ${name}" >&2
  return 1
}

require_cmd_vel_subscriber() {
  local attempt info
  for attempt in {1..30}; do
    info="$(ros2 node info /g1_cmd_vel_bridge 2>/dev/null || true)"
    if grep -Fq '/cmd_vel: geometry_msgs/msg/Twist' <<<"${info}"; then
      echo "G1 /cmd_vel bridge: subscribed"
      return
    fi
    sleep 1
  done
  echo "G1 /cmd_vel bridge did not subscribe to /cmd_vel" >&2
  return 1
}

require_rtsp_stream() {
  local rtsp_url="rtsp://${backend_host}:${MEDIA_RTSP_PORT:-8554}/${robot_id}"
  local probe attempt
  for attempt in {1..15}; do
    probe="$(docker exec swarmdeck-asimov-media timeout 20s \
      gst-launch-1.0 -v \
      rtspsrc location="${rtsp_url}" protocols=tcp latency=0 \
      ! rtph264depay ! fakesink sync=false 2>&1 || true)"
    if grep -Fq 'Sent PLAY request' <<<"${probe}" &&
       grep -Fq 'video/x-h264' <<<"${probe}"; then
      echo "MediaMTX RTSP: ${robot_id} H.264 stream is readable"
      return
    fi
    sleep 2
  done
  echo "MediaMTX RTSP: ${robot_id} stream is not readable at ${rtsp_url}" >&2
  echo "${probe}" | tail -n 30 >&2
  return 1
}

require_backend_registration() {
  local attempt
  for attempt in {1..30}; do
    if python3 - "${backend_host}" "${backend_port}" "${robot_id}" <<'PY'
import json
import sys
import urllib.request

host, port, expected = sys.argv[1:]
try:
    with urllib.request.urlopen(f"http://{host}:{port}/api/fleet", timeout=4) as response:
        payload = json.load(response)
except Exception:
    raise SystemExit(1)
robots = payload.get("robots") if isinstance(payload, dict) else []
if not isinstance(robots, list):
    raise SystemExit(1)
if not any(
    isinstance(robot, dict)
    and robot.get("robot_id") == expected
    and robot.get("online") is True
    for robot in robots
):
    raise SystemExit(1)
PY
    then
      echo "SwarmDeck backend: ${robot_id} registered and reporting live state"
      return
    fi
    sleep 2
  done
  echo "SwarmDeck backend did not report ${robot_id} online at http://${backend_host}:${backend_port}/api/fleet" >&2
  return 1
}

require_service /g1_loco_bridge/start "G1 locomotion services"
require_service /g1_loco_bridge/damp "G1 damping service"
require_cmd_vel_subscriber
require_topic /odom "G1 odometry"
require_topic /joint_states "G1 joint state"
require_rtsp_stream
require_backend_registration

"${compose[@]}" --profile '*' ps --all
echo "${robot_id}: ready"
REMOTE_SCRIPT
