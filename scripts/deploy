#!/usr/bin/env bash
# Operator-side full deployment. Robot-specific defaults live in
# deploy/robots/<name>.env. A new Compose robot needs a profile and a Compose
# file, not another branch in this script.
#
# Default lifecycle: sync -> override -> build -> reset stack -> up -> verify.
# Reset means `docker compose down --remove-orphans`; it never moves a physical
# robot or resets SLAM. Real adapters do not expose the simulator-only reset.

set -Eeuo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE_DIR="$REPO/deploy/robots"
FLEET_ENV="$REPO/deploy/fleet.env"

# Recover live SSH agent socket if the current one is disconnected/stale
if [[ -d /root/.ssh_host/agent ]]; then
  for _sock in $(ls -t /root/.ssh_host/agent/s.* 2>/dev/null); do
    if python3 -c "import socket, sys; s = socket.socket(socket.AF_UNIX); s.settimeout(0.5); s.connect(sys.argv[1])" "$_sock" 2>/dev/null; then
      export SSH_AUTH_SOCK="$_sock"
      break
    fi
  done
fi

SSH_OPTS=(-o ConnectTimeout=8 -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new)
RSYNC_RSH="ssh -o ConnectTimeout=8 -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new"

usage() {
  cat >&2 <<'USAGE'
usage: scripts/deploy <robot|all> [options]

Default stages: sync, override, build, reset stack, up, verify.

  --dry-run       show sync/override; perform no writes
  --no-sync       keep the remote checkout
  --no-build      reuse existing images
  --no-reset      keep the existing stack while recreating it
  --no-native-reset
                  keep the profile's native ROS launchers running
  --no-up         stop after sync/override/build (also disables reset/verify)
  --no-verify     skip the post-up container/mount check
USAGE
  exit 2
}

die() {
  echo "deploy: $*" >&2
  exit 1
}

profile_names() {
  local file
  for file in "$PROFILE_DIR"/*.env; do
    [[ -f "$file" ]] || continue
    basename "$file" .env
  done | sort
}

load_profile() {
  local target="$1" profile="$PROFILE_DIR/$1.env"
  [[ -f "$profile" ]] || die "unknown robot '$target' (profiles: $(profile_names | paste -sd, -))"
  [[ -f "$FLEET_ENV" ]] || die "missing fleet config: $FLEET_ENV"
  # Fleet settings and profiles are trusted, repository-owned shell fragments.
  # Their := defaults preserve values supplied by the operator on the command
  # line. Fleet settings are sourced first so robot profiles can use them.
  # shellcheck disable=SC1090
  source "$FLEET_ENV"
  # shellcheck disable=SC1090
  source "$profile"

  : "${DEPLOY_GLOBAL_ENV_KEYS:?fleet config must define DEPLOY_GLOBAL_ENV_KEYS}"
  : "${DEPLOY_SSH_HOST:?profile must define DEPLOY_SSH_HOST}"
  : "${DEPLOY_REMOTE_REPO:?profile must define DEPLOY_REMOTE_REPO}"
  : "${DEPLOY_COMPOSE_FILE:?profile must define DEPLOY_COMPOSE_FILE}"
  : "${DEPLOY_ENV_KEYS:?profile must define DEPLOY_ENV_KEYS}"
  : "${DEPLOY_COMPOSE_PROFILES:=}"
  : "${DEPLOY_CHECK_CONTAINERS:=}"
  : "${DEPLOY_ROBOT_ID:=}"
  : "${DEPLOY_PRE_BUILD_SCRIPT:=}"
  : "${DEPLOY_OPERATOR_UP_SCRIPT:=}"
  : "${DEPLOY_OPERATOR_UP_KEYS:=}"
  [[ -f "$REPO/$DEPLOY_COMPOSE_FILE" ]] || die "missing $DEPLOY_COMPOSE_FILE"
  if [[ -n "$DEPLOY_PRE_BUILD_SCRIPT" ]]; then
    [[ -x "$REPO/$DEPLOY_PRE_BUILD_SCRIPT" ]] || die "not executable: $DEPLOY_PRE_BUILD_SCRIPT"
  fi
  if [[ -n "$DEPLOY_OPERATOR_UP_SCRIPT" ]]; then
    [[ -x "$REPO/$DEPLOY_OPERATOR_UP_SCRIPT" ]] || die "not executable: $DEPLOY_OPERATOR_UP_SCRIPT"
  fi

  local key
  for key in ${DEPLOY_REQUIRED_VARS:-}; do
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "invalid required variable: $key"
    [[ -n "${!key:-}" ]] || die "$target requires $key"
  done
}

remote_quote() {
  printf '%q' "$1"
}

preflight() {
  echo "  checking SSH..."
  local output status
  set +e
  output="$(timeout 20 ssh "${SSH_OPTS[@]}" "$DEPLOY_SSH_HOST" true 2>&1)"
  status=$?
  set -e
  ((status == 0)) && return 0
  case "${output,,}" in
    *"permission denied"*|*"no identities"*)
      die "SSH authentication failed for $DEPLOY_SSH_HOST; verify the mounted/forwarded SSH agent"
      ;;
    *"timed out"*|*"no route to host"*|*"could not resolve"*|*"connection refused"*)
      die "$DEPLOY_SSH_HOST is unreachable: ${output//$'\n'/ }"
      ;;
    *)
      die "SSH preflight failed for $DEPLOY_SSH_HOST: ${output//$'\n'/ }"
      ;;
  esac
}

sync_repo() {
  local dry="$1" remote_repo
  remote_repo="$(remote_quote "$DEPLOY_REMOTE_REPO")"
  [[ "$dry" == yes ]] || ssh "${SSH_OPTS[@]}" "$DEPLOY_SSH_HOST" "mkdir -p -- $remote_repo"

  local flags=(
    -a --partial -e "$RSYNC_RSH"
    # .git without a trailing slash, so it matches the FILE a git worktree has
    # there as well as the directory a normal checkout has. With the slash,
    # deploying from a worktree tried to replace the robot's .git directory
    # with that file and rsync exited 23 ("cannot delete non-empty directory:
    # .git"). deploy_one runs under `|| failed=...`, which suppresses errexit,
    # so that surfaced as a partial sync behind a "deployment complete."
    --exclude=.git --exclude=.deploy/ --exclude=.env --exclude=.env.*
    --exclude=__pycache__/ --exclude='*.pyc' --exclude='*.pre-duck-map-*'
    --exclude=sessions/ --exclude=server/.venv/ --exclude=slam/.venv/ --exclude=ui/node_modules/
    --exclude=ui/dist/ --exclude=swarmdeck_ros/build/
    --exclude=swarmdeck_ros/install/ --exclude=swarmdeck_ros/log/
    --exclude=.aslan_ros/ --exclude=.aslan_pip/ --exclude=.spot_pip/
  )
  [[ "$dry" == yes ]] && flags+=(--dry-run --itemize-changes)
  echo "  syncing checkout -> $DEPLOY_SSH_HOST:$DEPLOY_REMOTE_REPO"
  rsync "${flags[@]}" "$REPO/" "$DEPLOY_SSH_HOST:$DEPLOY_REMOTE_REPO/"
}

write_overrides() {
  local target="$1" dry="$2" remote_env="$DEPLOY_REMOTE_REPO/.deploy/$target.env" tmp
  tmp="$(mktemp)"
  {
    echo "# Generated by scripts/deploy."
    local key value
    local -A seen=()
    for key in $DEPLOY_GLOBAL_ENV_KEYS $DEPLOY_ENV_KEYS; do
      [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "invalid environment key: $key"
      [[ -z "${seen[$key]:-}" ]] || continue
      seen[$key]=yes
      # Optional profile knobs should use the Compose/script default when they
      # were not set, rather than becoming empty entries in every robot env.
      [[ -n "${!key+x}" ]] || continue
      value="${!key:-}"
      case "$value" in
        *$'\n'*|*$'\r'*) die "$key contains a newline" ;;
      esac
      printf '%s=%s\n' "$key" "$value"
    done
  } >"$tmp"

  if [[ "$dry" == yes ]]; then
    echo "  override file (not written): $remote_env"
    sed 's/=.*/=<set>/' "$tmp"
    rm -f "$tmp"
    return
  fi

  local qdir qfile
  qdir="$(remote_quote "$DEPLOY_REMOTE_REPO/.deploy")"
  qfile="$(remote_quote "$remote_env")"
  echo "  writing Compose overrides -> $remote_env"
  base64 <"$tmp" | ssh "${SSH_OPTS[@]}" "$DEPLOY_SSH_HOST" \
    "umask 077 && mkdir -p -- $qdir && base64 -d > $qfile && chmod 600 $qfile"
  rm -f "$tmp"
}

run_remote() {
  local target="$1" build="$2" reset="$3" up="$4" verify="$5"
  local remote_env="$DEPLOY_REMOTE_REPO/.deploy/$target.env"
  local pre_build="$DEPLOY_PRE_BUILD_SCRIPT"
  [[ "$build" == yes ]] || pre_build=""
  local command
  printf -v command '%q ' \
    "$DEPLOY_REMOTE_REPO/scripts/deploy-remote" \
    "$DEPLOY_REMOTE_REPO" "$remote_env" "$DEPLOY_COMPOSE_FILE" \
    "$build" "$reset" "$up" "$verify" "$DEPLOY_CHECK_CONTAINERS" "$pre_build" \
    "$DEPLOY_COMPOSE_PROFILES" "$BACKEND_HOST" "$BACKEND_PORT" "$DEPLOY_ROBOT_ID"
  ssh "${SSH_OPTS[@]}" "$DEPLOY_SSH_HOST" "$command"
}

run_operator_up() {
  [[ -n "$DEPLOY_OPERATOR_UP_SCRIPT" ]] || return 0
  local assignments=() key value
  for key in $DEPLOY_OPERATOR_UP_KEYS; do
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "invalid operator environment key: $key"
    value="${!key:-}"
    assignments+=("$key=$value")
  done
  echo "  starting native robot graph with $DEPLOY_OPERATOR_UP_SCRIPT"
  env "${assignments[@]}" "$REPO/$DEPLOY_OPERATOR_UP_SCRIPT"
}

# The sync ships the operator's working tree, not a named revision, so a stale
# or dirty checkout silently downgrades the robot: on 2026-09-01 a benchbot
# deploy overwrote deploy/compose/docker-compose.robot-botman.yml with a copy
# predating the Fast DDS large-data profile, and /ouster/points fell back to
# 5 Hz with no sign in the deploy output that anything had regressed. Report
# what is about to be shipped, and say so when it is not what the operator
# probably expects. This never fetches, so "behind" is against the last fetch.
report_source() {
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "  source: $REPO (not a git checkout)"
    return 0
  }
  local head branch dirty upstream behind
  head="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  branch="$(git -C "$REPO" branch --show-current 2>/dev/null || true)"
  echo "  source: ${branch:-detached HEAD} @ $head"

  dirty="$(git -C "$REPO" status --porcelain -- adapters deploy scripts swarmdeck_ros 2>/dev/null | head -5)"
  if [[ -n "$dirty" ]]; then
    echo "  warning: uncommitted changes will be deployed:" >&2
    printf '%s\n' "$dirty" | sed 's/^/    /' >&2
  fi

  upstream="$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  [[ -n "$upstream" ]] || return 0
  behind="$(git -C "$REPO" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
  if [[ "$behind" != 0 ]]; then
    echo "  warning: $behind commit(s) behind $upstream as of the last fetch;" >&2
    echo "           the robot will receive this older tree. Pull before deploying." >&2
  fi
}

deploy_one() (
  local target="$1" dry="$2" sync="$3" build="$4" reset="$5" up="$6" verify="$7" native_reset="$8" container_reset="$9"
  load_profile "$target"
  if [[ "$target" == scout ]]; then
    SCOUT_NATIVE_RESET="$native_reset"
    SCOUT_CONTAINER_RESET="$container_reset"
    export SCOUT_NATIVE_RESET
    export SCOUT_CONTAINER_RESET
  elif [[ "$target" == asimov ]]; then
    ASIMOV_NATIVE_RESET="$native_reset"
    ASIMOV_CONTAINER_RESET="$container_reset"
    export ASIMOV_NATIVE_RESET
    export ASIMOV_CONTAINER_RESET
  fi
  echo "──────── $target  ($DEPLOY_SSH_HOST:$DEPLOY_REMOTE_REPO)"
  preflight

  if [[ "$dry" == yes ]]; then
    if [[ "$sync" == yes ]]; then
      sync_repo yes
    else
      echo "  sync: skipped"
    fi
    write_overrides "$target" yes
    echo "  stages: $([[ "$sync" == yes ]] && echo sync || echo no-sync) override"
    [[ "$build" == yes ]] && echo "  would: build"
    [[ "$reset" == yes ]] && echo "  would: reset stack"
    [[ "$up" == yes ]] && echo "  would: up"
    if [[ "$target" == scout ]]; then
      [[ "$native_reset" == yes ]] && echo "  would: reset native ROS launchers" ||
        echo "  native ROS reset: skipped"
    elif [[ "$target" == asimov ]]; then
      [[ "$native_reset" == yes ]] && echo "  would: reset native G1 bridge" ||
        echo "  native G1 bridge reset: skipped"
    fi
    return 0
  fi

  [[ "$sync" == yes ]] && sync_repo no
  write_overrides "$target" no
  local compose_up="$up"
  [[ -n "$DEPLOY_OPERATOR_UP_SCRIPT" ]] && compose_up=no
  local remote_verify="$verify"
  # Native ROS operators bring the Compose services up themselves after the
  # host graph is ready. The generic remote verifier would otherwise inspect
  # containers during the intentional gap between `down` and `scout-up`.
  [[ -n "$DEPLOY_OPERATOR_UP_SCRIPT" ]] && remote_verify=no
  run_remote "$target" "$build" "$reset" "$compose_up" "$remote_verify" || return 1
  if [[ "$up" == yes ]]; then
    run_operator_up || return 1
  fi
  echo "  $target: ready"
)

main() {
  [[ $# -ge 1 ]] || usage
  local target="$1"; shift
  local dry=no sync=yes build=yes reset=yes up=yes verify=yes native_reset=yes container_reset=yes
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=yes ;;
      --no-sync) sync=no ;;
      --no-build) build=no ;;
      --no-reset) reset=no; container_reset=no ;;
      --no-native-reset) native_reset=no ;;
      --no-up) up=no; reset=no; verify=no; native_reset=no; container_reset=no ;;
      --no-verify) verify=no ;;
      *) usage ;;
    esac
    shift
  done
  [[ "$up" == yes || "$reset" == no ]] || die "--no-up requires --no-reset"

  report_source

  local targets=()
  if [[ "$target" == all ]]; then
    mapfile -t targets < <(profile_names)
    ((${#targets[@]} > 0)) || die "no profiles found in $PROFILE_DIR"
  else
    targets=("$target")
  fi

  local name failed=0
  for name in "${targets[@]}"; do
    deploy_one "$name" "$dry" "$sync" "$build" "$reset" "$up" "$verify" "$native_reset" "$container_reset" ||
      failed=$((failed + 1))
  done
  echo
  if ((failed)); then
    echo "$failed robot(s) failed." >&2
    exit 1
  fi
  echo "deployment complete."
}

main "$@"
