#!/usr/bin/env bash

set -Eeuo pipefail

# Use the same server/media defaults as every deployment, including when this
# low-level helper is run directly instead of through scripts/deploy.
operator_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "${operator_repo}/deploy/fleet.env"

# Run from the operator workstation. Each setting can be overridden inline, e.g.
# DEPLOY_SSH_HOST=rover@192.168.1.24 BACKEND_HOST=192.168.1.10 \
#   ./scripts/scout-up
scout_host=${DEPLOY_SSH_HOST:-scout}
scout_repo=${DEPLOY_REMOTE_REPO:-${ROBOT_REPO:-/ssd/swarmdeck}}
robot_id=${ROBOT_ID:-tars_0}
robot_ip=${ROBOT_IP:-192.168.1.230}
backend_host=$BACKEND_HOST
backend_port=$BACKEND_PORT
ouster_host=${OUSTER_HOST_NAME:-os-992039000794.local}
camera_topic=${CAMERA_TOPIC:-/d400_arm/color/image_raw/compressed}
robot_config=${ROBOT_CONFIG:-adapters/adapter_ros1/config/scout_mini.yaml}
video_bitrate=$VIDEO_BITRATE_KBPS
video_fps=$VIDEO_FPS
native_reset=${SCOUT_NATIVE_RESET:-yes}
container_reset=${SCOUT_CONTAINER_RESET:-yes}

case "$native_reset" in
  yes|no) ;;
  *)
    echo "SCOUT_NATIVE_RESET must be yes or no (got '$native_reset')" >&2
    exit 2
    ;;
esac

case "$container_reset" in
  yes|no) ;;
  *)
    echo "SCOUT_CONTAINER_RESET must be yes or no (got '$container_reset')" >&2
    exit 2
    ;;
esac

# These values are also consumed by the operator-side Compose refresh after the
# SSH session returns. Export them explicitly so direct `scripts/scout-up` calls
# behave the same as calls made through `scripts/deploy`.
export ROBOT_ID="$robot_id"
export ROBOT_IP="$robot_ip"
export BACKEND_HOST="$backend_host"
export BACKEND_PORT="$backend_port"
export ROBOT_CONFIG="$robot_config"
export CAMERA_TOPIC="$camera_topic"
export VIDEO_BITRATE_KBPS="$video_bitrate"
export VIDEO_FPS="$video_fps"

echo "Starting ${robot_id} on ${scout_host}..."

ssh "${scout_host}" bash --noprofile --norc -s -- \
  "${scout_repo}" \
  "${SCOUT_CATKIN_WS:-/ssd/catkin_ws}" \
  "${SCOUT_MIST_WS:-/ssd/mist_ws}" \
  "${robot_id}" \
  "${robot_ip}" \
  "${backend_host}" \
  "${backend_port}" \
  "${ouster_host}" \
  "${camera_topic}" \
  "${robot_config}" \
  "${video_bitrate}" \
  "${video_fps}" \
  "${native_reset}" <<'REMOTE_SCRIPT'
set -Eeuo pipefail

repo=$1
catkin_ws=$2
mist_ws=$3
robot_id=$4
robot_ip=$5
backend_host=$6
backend_port=$7
ouster_host=$8
camera_topic=$9
robot_config=${10}
video_bitrate=${11}
video_fps=${12}
native_reset=${13:-yes}

slam_log=/tmp/swarmdeck-scout-slam.log
camera_log=/tmp/swarmdeck-scout-camera.log
planner_log=/tmp/swarmdeck-scout-planner.log
slam_launch="${repo}/adapters/adapter_ros1/launch/scout_mini_slam.launch"
camera_launch="${repo}/adapters/adapter_ros1/launch/scout_camera_low_latency.launch"
planner_launch="${repo}/adapters/adapter_ros1/launch/local_planner_muxed.launch"

case "$native_reset" in
  yes|no) ;;
  *)
    echo "native ROS reset must be yes or no (got '$native_reset')" >&2
    exit 2
    ;;
esac

# Catkin's generated setup hooks inspect variables before defining them, so nounset
# must be disabled only while those trusted environment scripts are sourced.
set +u
source /opt/ros/noetic/setup.bash
source "${catkin_ws}/devel/setup.bash"
source "${mist_ws}/devel/setup.bash"
set -u

export ROBOT_ID="${robot_id}"
export ROBOT_REPO="${repo}"
export OUSTER_HOST_NAME="${ouster_host}"
export ROS_IP="${robot_ip}"
export ROS_MASTER_URI="http://${robot_ip}:11311"

process_ids() {
  pgrep -f "$1" || true
}

stop_matching() {
  local label=$1 pattern=$2 attempt
  local -a pids=()

  mapfile -t pids < <(process_ids "$pattern")
  if ((${#pids[@]} == 0)); then
    echo "${label}: not running"
    return
  fi

  echo "${label}: stopping ${#pids[@]} process(es)"
  kill -INT "${pids[@]}" 2>/dev/null || true
  for attempt in {1..10}; do
    mapfile -t pids < <(process_ids "$pattern")
    ((${#pids[@]} == 0)) && return
    sleep 1
  done

  echo "${label}: still running; sending TERM" >&2
  kill -TERM "${pids[@]}" 2>/dev/null || true
  for attempt in {1..5}; do
    mapfile -t pids < <(process_ids "$pattern")
    ((${#pids[@]} == 0)) && return
    sleep 1
  done

  echo "${label}: still running; sending KILL" >&2
  kill -KILL "${pids[@]}" 2>/dev/null || true
}

reset_native_graph() {
  if [[ "$native_reset" != yes ]]; then
    echo "Native ROS reset: skipped"
    return
  fi

  echo "Resetting known Scout ROS launchers..."
  # Stop launch parents first so their child nodes receive the normal ROS
  # shutdown path. The patterns are deliberately tied to Scout's launch files;
  # roscore and unrelated robot processes are left alone.
  stop_matching "Local planner" "[l]ocal_planner_muxed.launch"
  stop_matching "D400 mount TF" "[s]tatic_transform_publisher 0 0 0 0 0 0 realsense_d435_link d400_arm_link"
  stop_matching "RealSense legacy camera" "[r]oslaunch rover_launch rs_d400.launch"
  stop_matching "RealSense camera" "[r]oslaunch .*${camera_launch}"
  stop_matching "ROS/SLAM" "[r]oslaunch .*${slam_launch}"
}

reset_containers() {
  if ! docker compose version >/dev/null 2>&1; then
    echo "Scout clean refresh requires Docker Compose v2" >&2
    exit 1
  fi

  export ROBOT_REPO="${operator_repo}"
  local -a compose=(docker compose --project-name swarmdeck-scout)
  [[ -f "${operator_repo}/.deploy/scout.env" ]] &&
    compose+=(--env-file "${operator_repo}/.deploy/scout.env")
  compose+=(--file "${operator_repo}/deploy/compose/docker-compose.robot-ros1.yml")

  if [[ "$container_reset" == yes ]]; then
    echo "Resetting Scout containers..."
    "${compose[@]}" down --remove-orphans

    # Explicit container names allow us to clean containers created by an older
    # Compose project name as well as containers managed by this one. Do not
    # remove volumes: detector weights are intentionally cached across deploys.
    for container in swarmdeck-duck-detector swarmdeck-adapter swarmdeck-media; do
      if docker inspect "$container" >/dev/null 2>&1; then
        docker rm -f "$container" >/dev/null
      fi
    done
  else
    echo "Scout container reset: skipped"
  fi

  "${compose[@]}" up -d --force-recreate --remove-orphans
}

start_detached() {
  local label=$1
  local pattern=$2
  local log_file=$3
  shift 3

  if pgrep -f "${pattern}" >/dev/null; then
    echo "${label}: already running"
    return
  fi

  nohup "$@" >"${log_file}" 2>&1 </dev/null &
  echo "${label}: started (log: ${log_file})"
}

wait_for_master() {
  local attempt
  for attempt in {1..15}; do
    if rosnode list >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done

  echo "ROS master did not become available; recent SLAM log:" >&2
  tail -n 40 "${slam_log}" >&2 || true
  return 1
}

require_topic() {
  local topic=$1
  local label=$2

  if timeout 20 rostopic echo -n 1 "${topic}" >/dev/null 2>&1; then
    echo "${label}: receiving data"
    return
  fi

  echo "${label}: no data received on ${topic}" >&2
  return 1
}

require_subscriber() {
  local topic=$1
  local subscriber=$2
  local label=$3
  local attempt

  for attempt in {1..30}; do
    if rostopic info "${topic}" 2>/dev/null | grep -Fq "${subscriber}"; then
      echo "${label}: subscribed"
      return
    fi
    sleep 1
  done

  echo "${label}: did not subscribe to ${topic}" >&2
  return 1
}

reset_native_graph
reset_containers

start_detached \
  "ROS/SLAM" \
  "[r]oslaunch .*${slam_launch}" \
  "${slam_log}" \
  roslaunch "${slam_launch}"

wait_for_master

# Colour publishes immediately. Depth is a slower unsynced stream used only
# to pin detections on the map. Do not fall back to rs_d400.launch: that
# vendor profile holds colour until depth on this USB 2.1 camera.
if pgrep -f "[r]oslaunch rover_launch rs_d400.launch" >/dev/null; then
  echo "RealSense camera: vendor rs_d400.launch is already running." >&2
  echo "That profile is why teleop video lags. Stop it and re-run make deploy ROBOT=scout" >&2
  echo "so scout_camera_low_latency.launch can own the D435i." >&2
else
  start_detached \
    "RealSense camera" \
    "[r]oslaunch .*${camera_launch}" \
    "${camera_log}" \
    roslaunch "${camera_launch}"
fi

# The low-latency launch already publishes this mount TF. Keep a copy for the
# case where someone started the camera by hand without that launch file.
start_detached \
  "D400 mount TF" \
  "[s]tatic_transform_publisher 0 0 0 0 0 0 realsense_d435_link d400_arm_link" \
  /tmp/swarmdeck-d400-mount.log \
  rosrun tf static_transform_publisher 0 0 0 0 0 0 realsense_d435_link d400_arm_link 100

# localPlanner + pathFollower, muxed so pathFollower's continuous ~27 Hz
# output lands on /cmd_vel_nav instead of the real /cmd_vel — see the launch
# file's own header for why that remap (and autonomyMode:=false) matter.
# Starting this does NOT move the robot by itself: the adapter only relays
# /cmd_vel_nav onto the real /cmd_vel while a nav goal is active.
start_detached \
  "Local planner" \
  "[l]ocal_planner_muxed.launch" \
  "${planner_log}" \
  roslaunch "${planner_launch}"

export ROBOT_IP="${robot_ip}"
export BACKEND_HOST="${backend_host}"
export BACKEND_PORT="${backend_port}"
export ROBOT_CONFIG="${robot_config}"
export CAMERA_TOPIC="${camera_topic}"
export VIDEO_BITRATE_KBPS="${video_bitrate}"
export VIDEO_FPS="${video_fps}"

require_topic /os_cloud_node/points "Ouster point cloud"
require_topic /odometry/filtered "Filtered odometry"
require_topic "${camera_topic}" "RealSense camera"
require_topic /path "Local planner"
require_subscriber \
  "${camera_topic}" "/swarmdeck_adapter_${robot_id}" "SwarmDeck adapter"
require_subscriber \
  "${camera_topic}" "/swarmdeck_media_${robot_id}" "SwarmDeck media"

require_backend_registration() {
  local attempt
  for attempt in {1..30}; do
    if python3 - "${backend_host}" "${backend_port}" "${robot_id}" <<'PY'
import json
import sys
import urllib.request

host, port, expected = sys.argv[1:]
try:
    with urllib.request.urlopen(f"http://{host}:{port}/api/fleet", timeout=4) as response:
        payload = json.load(response)
except Exception:
    raise SystemExit(1)
robots = payload.get("robots") if isinstance(payload, dict) else []
if not isinstance(robots, list):
    raise SystemExit(1)
if not any(
    isinstance(robot, dict)
    and robot.get("robot_id") == expected
    and robot.get("online") is True
    for robot in robots
):
    raise SystemExit(1)
PY
    then
      echo "SwarmDeck backend: ${robot_id} registered and reporting live state"
      return
    fi
    sleep 2
  done

  echo "SwarmDeck backend did not report ${robot_id} online at http://${backend_host}:${backend_port}/api/fleet" >&2
  return 1
}

require_backend_registration

echo "${robot_id}: ready"
REMOTE_SCRIPT
