#!/usr/bin/env bash
# ==============================================================================
# SwarmDeck Scout Mini (TARS) Bring-Up Script (scripts/scout-up)
# ==============================================================================
#
# Starts Scout's host-side ROS 1 Noetic stack (LVI-SAM, Ouster OS1, VectorNav,
# RealSense D435, local planner) and its SwarmDeck Docker Compose services
# (adapter, media streaming, object detector).
# Runs on the operator workstation and performs bring-up over SSH.
#
# Examples:
#   ./scripts/scout-up                      # Standard bring-up (reset + start)
#   ./scripts/scout-up --dry-run            # Inspect commands without executing
#   ./scripts/scout-up --status             # Check running ROS 1 nodes & containers
#   ./scripts/scout-up --down               # Stop native nodes and containers
#   ./scripts/scout-up --no-native-reset    # Keep existing native ROS 1 graph running
# ==============================================================================

set -Eeuo pipefail

operator_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "${operator_repo}/deploy/fleet.env" ]]; then
  # shellcheck disable=SC1091
  source "${operator_repo}/deploy/fleet.env"
fi

# Configuration defaults
scout_host="${DEPLOY_SSH_HOST:-scout}"
scout_repo="${DEPLOY_REMOTE_REPO:-${ROBOT_REPO:-/ssd/swarmdeck}}"
robot_id="${ROBOT_ID:-tars_0}"
robot_ip="${ROBOT_IP:-192.168.1.230}"
backend_host="${BACKEND_HOST:-192.168.1.161}"
backend_port="${BACKEND_PORT:-8080}"
media_rtsp_port="${MEDIA_RTSP_PORT:-8554}"
ouster_host="${OUSTER_HOST_NAME:-os-992039000794.local}"
camera_topic="${CAMERA_TOPIC:-/d400_arm/color/image_raw/compressed}"
robot_config="${ROBOT_CONFIG:-adapters/adapter_ros1/config/scout_mini.yaml}"
video_bitrate="${VIDEO_BITRATE_KBPS:-700}"
video_fps="${VIDEO_FPS:-10}"
video_width="${VIDEO_WIDTH:-640}"
video_height="${VIDEO_HEIGHT:-480}"
native_reset="${SCOUT_NATIVE_RESET:-yes}"
container_reset="${SCOUT_CONTAINER_RESET:-yes}"
action="up"

usage() {
  cat <<'EOF'
SwarmDeck Scout Mini (TARS) Bring-Up (scripts/scout-up)

Usage:
  scripts/scout-up [options]

Lifecycle Actions:
  (default)           Start native ROS 1 nodes, planner, and Compose containers
  --down, --stop      Stop native Scout ROS 1 nodes and remove Compose containers
  --status            Check status of native processes, ROS topics, and containers
  --dry-run           Print connection details and commands without executing
  -h, --help          Show this help message

Options:
  --host <ssh_host>   Target SSH host/alias (default: $DEPLOY_SSH_HOST or 'scout')
  --no-native-reset   Do not restart native ROS 1 nodes (LVI-SAM, camera, planner)
  --no-container-reset
                      Do not recreate Docker containers (preserve running stack)
  --backend-host <ip> SwarmDeck backend IP (default: $BACKEND_HOST)
  --backend-port <p>  SwarmDeck backend port (default: $BACKEND_PORT or 8080)

Environment Variables:
  DEPLOY_SSH_HOST, DEPLOY_REMOTE_REPO, ROBOT_ID, ROBOT_IP,
  BACKEND_HOST, BACKEND_PORT, MEDIA_RTSP_PORT, OUSTER_HOST_NAME,
  SCOUT_NATIVE_RESET, SCOUT_CONTAINER_RESET
EOF
  exit 0
}

# Parse CLI options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --down|--stop)
      action="down"
      shift
      ;;
    --status)
      action="status"
      shift
      ;;
    --dry-run)
      action="dry-run"
      shift
      ;;
    --host)
      scout_host="$2"
      shift 2
      ;;
    --backend-host)
      backend_host="$2"
      shift 2
      ;;
    --backend-port)
      backend_port="$2"
      shift 2
      ;;
    --no-native-reset)
      native_reset="no"
      shift
      ;;
    --no-container-reset)
      container_reset="no"
      shift
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      echo "Run 'scripts/scout-up --help' for usage." >&2
      exit 2
      ;;
  esac
done

case "$native_reset" in
  yes|no) ;;
  *) echo "Error: SCOUT_NATIVE_RESET must be yes or no (got '$native_reset')" >&2; exit 2 ;;
esac
case "$container_reset" in
  yes|no) ;;
  *) echo "Error: SCOUT_CONTAINER_RESET must be yes or no (got '$container_reset')" >&2; exit 2 ;;
esac

export ROBOT_ID="$robot_id"
export ROBOT_IP="$robot_ip"
export BACKEND_HOST="$backend_host"
export BACKEND_PORT="$backend_port"
export ROBOT_CONFIG="$robot_config"
export CAMERA_TOPIC="$camera_topic"
export VIDEO_BITRATE_KBPS="$video_bitrate"
export VIDEO_FPS="$video_fps"
export VIDEO_WIDTH="$video_width"
export VIDEO_HEIGHT="$video_height"

if [[ "$action" == "dry-run" ]]; then
  cat <<EOF
Scout Bring-Up Configuration (Dry Run):
---------------------------------------
Target Host:        ${scout_host}
Remote Repo:        ${scout_repo}
Robot ID:           ${robot_id} (${robot_ip})
Backend Host:       ${backend_host}:${backend_port}
RTSP Media Port:    ${media_rtsp_port}
Ouster Hostname:    ${ouster_host}
Camera Topic:       ${camera_topic}
Native Reset:       ${native_reset}
Container Reset:    ${container_reset}
Action:             ${action}
EOF
  exit 0
fi

echo "Connecting to ${scout_host} (action: ${action}, robot: ${robot_id})..."

ssh "${scout_host}" bash --noprofile --norc -s -- \
  "${scout_repo}" \
  "${SCOUT_CATKIN_WS:-/ssd/catkin_ws}" \
  "${SCOUT_MIST_WS:-/ssd/mist_ws}" \
  "${robot_id}" \
  "${robot_ip}" \
  "${backend_host}" \
  "${backend_port}" \
  "${media_rtsp_port}" \
  "${ouster_host}" \
  "${camera_topic}" \
  "${robot_config}" \
  "${video_bitrate}" \
  "${video_fps}" \
  "${video_width}" \
  "${video_height}" \
  "${native_reset}" \
  "${container_reset}" \
  "${action}" <<'REMOTE_SCRIPT'
set -Eeuo pipefail

repo=$1
catkin_ws=$2
mist_ws=$3
robot_id=$4
robot_ip=$5
backend_host=$6
backend_port=$7
media_rtsp_port=$8
ouster_host=$9
camera_topic=${10}
robot_config=${11}
video_bitrate=${12}
video_fps=${13}
video_width=${14}
video_height=${15}
native_reset=${16:-yes}
container_reset=${17:-yes}
action=${18:-up}

slam_log=/tmp/swarmdeck-scout-slam.log
camera_log=/tmp/swarmdeck-scout-camera.log
planner_log=/tmp/swarmdeck-scout-planner.log
slam_launch="${repo}/adapters/adapter_ros1/launch/scout_mini_slam.launch"
camera_launch="${repo}/adapters/adapter_ros1/launch/scout_camera_low_latency.launch"
planner_launch="${repo}/adapters/adapter_ros1/launch/local_planner_muxed.launch"

set +u
source /opt/ros/noetic/setup.bash
source "${catkin_ws}/devel/setup.bash"
source "${mist_ws}/devel/setup.bash"
set -u

export ROBOT_ID="${robot_id}"
export ROBOT_REPO="${repo}"
export OUSTER_HOST_NAME="${ouster_host}"
export ROS_IP="${robot_ip}"
export ROS_MASTER_URI="http://${robot_ip}:11311"

process_ids() {
  pgrep -f "$1" || true
}

stop_matching() {
  local label=$1 pattern=$2 attempt
  local -a pids=()

  mapfile -t pids < <(process_ids "$pattern")
  if ((${#pids[@]} == 0)); then
    echo "${label}: not running"
    return
  fi

  echo "${label}: stopping ${#pids[@]} process(es)"
  kill -INT "${pids[@]}" 2>/dev/null || true
  for attempt in {1..10}; do
    mapfile -t pids < <(process_ids "$pattern")
    ((${#pids[@]} == 0)) && return
    sleep 1
  done

  echo "${label}: still running; sending TERM" >&2
  kill -TERM "${pids[@]}" 2>/dev/null || true
  for attempt in {1..5}; do
    mapfile -t pids < <(process_ids "$pattern")
    ((${#pids[@]} == 0)) && return
    sleep 1
  done

  echo "${label}: still running; sending KILL" >&2
  kill -KILL "${pids[@]}" 2>/dev/null || true
}

reset_native_graph() {
  echo "Stopping known Scout ROS launchers..."
  stop_matching "Local planner" "[l]ocal_planner_muxed.launch"
  stop_matching "D400 mount TF" "[s]tatic_transform_publisher 0 0 0 0 0 0 realsense_d435_link d400_arm_link"
  stop_matching "RealSense legacy camera" "[r]oslaunch rover_launch rs_d400.launch"
  stop_matching "RealSense camera" "[r]oslaunch .*${camera_launch}"
  stop_matching "ROS/SLAM" "[r]oslaunch .*${slam_launch}"
}

compose=(docker compose --project-name swarmdeck-scout)
if [[ -f "${repo}/.deploy/scout.env" ]]; then
  compose+=(--env-file "${repo}/.deploy/scout.env")
fi
compose+=(--file "${repo}/deploy/compose/docker-compose.robot-ros1.yml")

# --- Action: Status ---
if [[ "${action}" == "status" ]]; then
  echo "=== Scout Native ROS 1 Processes ==="
  for label in "ROS/SLAM" "RealSense camera" "Local planner"; do
    case "$label" in
      "ROS/SLAM") p="$(process_ids "[r]oslaunch .*${slam_launch}")" ;;
      "RealSense camera") p="$(process_ids "[r]oslaunch .*${camera_launch}")" ;;
      "Local planner") p="$(process_ids "[l]ocal_planner_muxed.launch")" ;;
    esac
    if [[ -n "$p" ]]; then
      echo "$label: running (PIDs: $p)"
    else
      echo "$label: not running"
    fi
  done
  echo ""
  echo "=== Scout Containers ==="
  "${compose[@]}" ps --all
  exit 0
fi

# --- Action: Down ---
if [[ "${action}" == "down" || "${action}" == "stop" ]]; then
  echo "Stopping Scout stack..."
  reset_native_graph
  echo "Stopping Compose containers..."
  "${compose[@]}" down --remove-orphans
  echo "Scout stack stopped."
  exit 0
fi

# --- Action: Up ---
if [[ "$native_reset" == yes ]]; then
  reset_native_graph
fi

reset_containers() {
  if ! docker compose version >/dev/null 2>&1; then
    echo "Scout clean refresh requires Docker Compose v2" >&2
    exit 1
  fi

  export ROBOT_REPO="${repo}"
  if [[ "$container_reset" == yes ]]; then
    echo "Resetting Scout containers..."
    "${compose[@]}" down --remove-orphans
    for container in swarmdeck-duck-detector swarmdeck-adapter swarmdeck-media; do
      if docker inspect "$container" >/dev/null 2>&1; then
        docker rm -f "$container" >/dev/null
      fi
    done
  else
    echo "Scout container reset: skipped"
  fi

  "${compose[@]}" up -d --force-recreate --remove-orphans
}

start_detached() {
  local label=$1
  local pattern=$2
  local log_file=$3
  shift 3

  if pgrep -f "${pattern}" >/dev/null; then
    echo "${label}: already running"
    return
  fi

  nohup "$@" >"${log_file}" 2>&1 </dev/null &
  echo "${label}: started (log: ${log_file})"
}

wait_for_master() {
  local attempt
  for attempt in {1..15}; do
    if rosnode list >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done

  echo "ROS master did not become available; recent SLAM log:" >&2
  tail -n 40 "${slam_log}" >&2 || true
  return 1
}

require_topic() {
  local topic=$1
  local label=$2

  if timeout 20 rostopic echo -n 1 "${topic}" >/dev/null 2>&1; then
    echo "${label}: receiving data"
    return
  fi

  echo "${label} is not publishing on ${topic}" >&2
  return 1
}

require_subscriber() {
  local topic=$1
  local expected_node=$2
  local label=$3
  local attempt info

  for attempt in {1..15}; do
    info="$(rostopic info "${topic}" 2>/dev/null || true)"
    if grep -Fq "${expected_node}" <<<"${info}"; then
      echo "${label}: subscribed to ${topic}"
      return
    fi
    sleep 1
  done

  echo "${label} did not subscribe to ${topic} after 15 attempts" >&2
  echo "${info}" | sed 's/^/  /' >&2
  return 1
}

reset_containers

start_detached \
  "ROS master and SLAM" \
  "[r]oslaunch .*${slam_launch}" \
  "${slam_log}" \
  roslaunch "${slam_launch}"

wait_for_master

start_detached \
  "RealSense camera" \
  "[r]oslaunch .*${camera_launch}" \
  "${camera_log}" \
  roslaunch "${camera_launch}"

start_detached \
  "D400 mount TF" \
  "[s]tatic_transform_publisher 0 0 0 0 0 0 realsense_d435_link d400_arm_link" \
  /tmp/swarmdeck-d400-mount.log \
  rosrun tf static_transform_publisher 0 0 0 0 0 0 realsense_d435_link d400_arm_link 100

start_detached \
  "Local planner" \
  "[l]ocal_planner_muxed.launch" \
  "${planner_log}" \
  roslaunch "${planner_launch}"

export ROBOT_IP="${robot_ip}"
export BACKEND_HOST="${backend_host}"
export BACKEND_PORT="${backend_port}"
export ROBOT_CONFIG="${robot_config}"
export CAMERA_TOPIC="${camera_topic}"
export VIDEO_BITRATE_KBPS="${video_bitrate}"
export VIDEO_FPS="${video_fps}"
export VIDEO_WIDTH="${video_width}"
export VIDEO_HEIGHT="${video_height}"

require_topic /os_cloud_node/points "Ouster point cloud"
require_topic /odometry/filtered "Filtered odometry"
require_topic "${camera_topic}" "RealSense camera"
require_topic /path "Local planner"
require_subscriber \
  "${camera_topic}" "/swarmdeck_adapter_${robot_id}" "SwarmDeck adapter"
require_subscriber \
  "${camera_topic}" "/swarmdeck_media_${robot_id}" "SwarmDeck media"

require_rtsp_stream() {
  local rtsp_url="rtsp://${backend_host}:${media_rtsp_port}/${robot_id}"
  local probe
  probe="$(
    docker exec swarmdeck-media timeout 8s \
      gst-launch-1.0 -v \
      rtspsrc location="${rtsp_url}" protocols=tcp latency=0 \
      ! rtph264depay ! fakesink sync=false 2>&1 || true
  )"
  if grep -Fq "Sent PLAY request" <<<"${probe}" &&
     grep -Fq "video/x-h264" <<<"${probe}"; then
    echo "MediaMTX RTSP: ${robot_id} H.264 stream is readable"
    return 0
  fi
  echo "MediaMTX RTSP: ${robot_id} stream is not readable at ${rtsp_url}" >&2
  echo "${probe}" | tail -n 30 >&2
  return 1
}

require_rtsp_stream

require_backend_registration() {
  local attempt
  for attempt in {1..30}; do
    if python3 - "${backend_host}" "${backend_port}" "${robot_id}" <<'PY'
import json
import sys
import urllib.request

host, port, expected = sys.argv[1:]
try:
    with urllib.request.urlopen(f"http://{host}:{port}/api/fleet", timeout=4) as response:
        payload = json.load(response)
except Exception:
    raise SystemExit(1)
robots = payload.get("robots") if isinstance(payload, dict) else []
if not isinstance(robots, list):
    raise SystemExit(1)
if not any(
    isinstance(robot, dict)
    and robot.get("robot_id") == expected
    and robot.get("online") is True
    for robot in robots
):
    raise SystemExit(1)
PY
    then
      echo "SwarmDeck backend: ${robot_id} registered and reporting live state"
      return
    fi
    sleep 2
  done

  echo "SwarmDeck backend did not report ${robot_id} online at http://${backend_host}:${backend_port}/api/fleet" >&2
  return 1
}

require_backend_registration

echo "${robot_id}: ready"
REMOTE_SCRIPT
