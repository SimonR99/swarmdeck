<?xml version="1.0" ?>
<!--
  SwarmDeck simulated robot: the parts that are the SAME for every platform.

  This file owns the sensor suite, the noise models, the drive/odometry plugins
  and the topic names. The chassis — geometry, mass, wheels, joints, looks —
  comes from `chassis/<type>.xml`, whose three marked sections spawn_fleet.py
  splices into the placeholders below.

  It is split that way on purpose. The IMU noise figures, the lidar ring
  constraint and the 200 Hz inertial rate below are load-bearing physics with
  silent failure modes, and three copies of them would drift apart the first
  time one robot was tuned. A platform differs from another in how big it is and
  how it drives, not in what a MEMS gyro does.

  Placeholders are filled by spawn_fleet.py from ROBOT_PROFILES / LidarSpec.
-->
<sdf version="1.9">
  <model name="{{NAME}}">
    <pose>0 0 {{SPAWN_Z}} 0 0 0</pose>

    <link name="base_link">
{{CHASSIS}}

      <sensor name="lidar" type="gpu_lidar">
        <!--
          Mount height comes from the platform profile, not from this file. It
          must agree with the `lidar_x`/`lidar_z` arguments session.launch.py
          passes to slam.launch.py, which publish the base_link -> lidar static
          transform. A disagreement is not a small error: it tilts and offsets
          every scan, and SLAM cannot recover from a wrong extrinsic.
        -->
        <pose>{{LIDAR_X}} 0 {{LIDAR_Z}} 0 0 0</pose>
        <topic>{{NAME}}/scan</topic>
        <update_rate>{{LIDAR_RATE}}</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <!--
              Samples per revolution comes from the fleet config
              (`fleet.lidar`), because it is the single biggest lever on map
              quality. Adjacent rays land `range * 2pi/samples` apart, so 360
              samples/rev (1.003 deg) put them one 5 cm cell apart at 2.9 m and
              three cells apart at 8.6 m — which is why distant walls came out
              dotted rather than continuous, and why both scan matching and grid
              registration (each of which counts occupied cells) were working
              from thin evidence. Real units are 0.1-0.4 deg. See
              spawn_fleet.py's LIDAR_PROFILES.
            -->
            <horizontal><samples>{{LIDAR_HSAMPLES}}</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <!--
              Ring count is set by the fleet config (`fleet.lidar`, or the older
              `fleet.lidar_rings`) and defaults to 1, which is the 2D-only
              configuration: Gazebo then publishes a usable gz.msgs.LaserScan
              directly and pointcloud_to_laserscan drops out of the pipeline.

              If you raise it, RAISE IT TO AN ODD NUMBER. Gazebo spreads N
              samples evenly across [min_angle, max_angle] inclusive, so an even
              N puts no ring at elevation 0 and every ring is tilted. A tilted
              ring at elevation e crosses a height band of h at range h/sin(e)
              and is invisible beyond it, so with 8 rings over +/-0.26 rad the
              innermost sits at 0.0371 rad and a 0.15 m band truncates the whole
              scan at 4.04 m of the lidar's 16 m — the hatched wedge recorded in
              docs/KNOWN_ISSUES.md. No band fixes that, and no choice of filter
              frame fixes it either: the geometry is range-dependent in every
              frame. An odd N puts one ring at exactly 0 elevation, which passes
              any band at full range, and the tilted rings then add genuine 3D
              structure for a 3D-capable SLAM to use.
            -->
            <vertical><samples>{{LIDAR_RINGS}}</samples><resolution>1</resolution>
              <min_angle>{{LIDAR_VMIN}}</min_angle><max_angle>{{LIDAR_VMAX}}</max_angle></vertical>
          </scan>
          <range><min>0.15</min><max>{{LIDAR_RANGE_MAX}}</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>

      <!--
        Bumper-height obstacle lidar for Nav2's rolling costmap, and the sensor
        that makes robots see EACH OTHER. The mapping lidar sits high enough to
        clear the fleet's own bodies (deliberately — it must not write other
        robots into the SLAM map as walls), so without this scan a robot is
        blind to its neighbours and plans straight through them.

        Height and forward offset come from the platform profile: it has to
        start outside that chassis and still fall below the shortest robot in
        the fleet, or the tallest robot cannot see the shortest one.

        Never fed to SLAM. On hardware this maps to the front ToF / proximity
        safety sensors.
      -->
      <sensor name="proximity_lidar" type="gpu_lidar">
        <pose>{{PROX_X}} 0 {{PROX_Z}} 0 0 0</pose>
        <topic>{{NAME}}/proximity_scan</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal><samples>{{PROX_SAMPLES}}</samples><resolution>1</resolution>
              <min_angle>{{PROX_MIN_ANGLE}}</min_angle><max_angle>{{PROX_MAX_ANGLE}}</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.05</min><max>{{PROX_RANGE_MAX}}</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </lidar>
      </sensor>

      <!--
        200 Hz because this rate is a hard interface requirement, not a taste
        knob. Lidar-inertial odometry (FAST-LIO2, Point-LIO, LIO-SAM) integrates
        IMU between scans to de-skew them and to seed registration; below about
        100 Hz the preintegration error over one 10 Hz scan swamps the benefit
        and those packages either refuse to initialise or drift. Wheel+IMU EKF
        fusion is happy at 50 Hz, so drop back only if nothing downstream needs
        inertial odometry. See docs/collaborative-slam.md.
      -->
      <!--
        The noise block is not optional. Gazebo's default IMU is NOISELESS: it
        reports the simulator's exact angular rate. Fusing that into an EKF and
        then reporting that drift went away would be measuring ground truth
        laundered through a filter, and the result would not transfer to
        hardware. These are consumer-MEMS figures (MPU-6050 class): a gyro rate
        noise density of ~0.005 deg/s/sqrt(Hz) over a 100 Hz band gives about
        9e-4 rad/s, plus a slow bias random walk so heading drifts the way a real
        gyro's does. Downstream must earn its accuracy against that.
      -->
      <sensor name="imu" type="imu">
        <topic>{{NAME}}/imu</topic>
        <update_rate>200</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>9.0e-4</stddev>
              <bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-6</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>9.0e-4</stddev>
              <bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-6</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>9.0e-4</stddev>
              <bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-6</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!--
        RGB *and* depth from one sensor, because the two have to be pixel
        aligned. A rubber duck detected at box (x, y, w, h) becomes a marker on
        the operator's map only if some depth pixel inside that box belongs to
        the same duck; two independently posed cameras would agree near the
        optical axis and disagree at the edges, which is where a detection
        usually is. `rgbd_camera` renders both from one pose with one set of
        intrinsics, so the alignment is exact by construction rather than by
        calibration — the simulated equivalent of the RealSense's
        `aligned_depth_to_color` stream that the ROS 1 adapter consumes.

        Gazebo appends the stream name to this base topic:

          {{NAME}}/camera/image         RGB, what the operator sees
          {{NAME}}/camera/depth_image   32FC1 metres, same grid as the RGB
          {{NAME}}/camera/camera_info   intrinsics, needed to deproject
          {{NAME}}/camera/points        organised cloud — NOT bridged

        The cloud carries no geometry the depth image lacks and costs about
        70 MB/s per robot at this resolution; session.launch.py bridges the
        first three only. The depth image keeps the same clip planes as the
        colour image: adapters/perception/depth_projection.py applies its own
        min/max range, so a second, tighter limit here would only add a way for
        the two to disagree.
      -->
      <sensor name="camera" type="rgbd_camera">
        <pose>{{CAM_X}} 0 {{CAM_Z}} 0 0 0</pose>
        <topic>{{NAME}}/camera</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>40</far></clip>
        </camera>
      </sensor>
    </link>

{{EXTRA_LINKS}}

{{DRIVE_PLUGIN}}

    <!-- Ground truth pose, used to score map-merge accuracy (FR-M6). -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>{{NAME}}/base_link</robot_base_frame>
      <odom_topic>{{NAME}}/ground_truth</odom_topic>
      <odom_publish_frequency>10</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
