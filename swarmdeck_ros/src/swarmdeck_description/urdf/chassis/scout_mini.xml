<!--
  AgileX Scout Mini — 4WD skid-steer UGV.

  Nominal datasheet figures: 612 x 580 x 245 mm, ~23 kg, up to 3.0 m/s, 0.490 m
  track width, 0.451 m wheelbase, 175 mm wheel diameter. Confirm per unit.

  Four driven wheels, no steering: turning is pure skid, so the front and rear
  wheels on a side scrub in opposite directions through a turn. The diff-drive
  plugin is given the front pair; the rear pair is driven by the same joints'
  motion through the body and is present for load and looks. That is an
  approximation, and it is the honest one to make here — SwarmDeck only ever
  commands linear.x and angular.z, so what matters downstream is that the
  vehicle turns about the right centre with the right scrub, not that four
  contact patches are integrated individually.

  This file is read by spawn_fleet.py, which splits it on the @SECTION markers.
-->

<!-- @CHASSIS -->
      <inertial>
        <mass>23.0</mass>
        <inertia><ixx>0.75</ixx><iyy>0.82</iyy><izz>1.30</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>

      <collision name="collision">
        <geometry><box><size>0.612 0.580 0.245</size></box></geometry>
      </collision>

      <visual name="body">
        <geometry><box><size>0.612 0.580 0.200</size></box></geometry>
        <material><ambient>{{COLOR}} 1</ambient><diffuse>{{COLOR}} 1</diffuse></material>
      </visual>
      <visual name="deck">
        <pose>0 0 0.110 0 0 0</pose>
        <geometry><box><size>0.500 0.480 0.022</size></box></geometry>
        <material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.16 0.17 0.20 1</diffuse></material>
      </visual>
      <visual name="light_bar">
        <pose>0.300 0 0.040 0 0 0</pose>
        <geometry><box><size>0.020 0.420 0.045</size></box></geometry>
        <material><ambient>0.55 0.05 0.03 1</ambient><diffuse>0.85 0.08 0.05 1</diffuse></material>
      </visual>
      <visual name="mast">
        <pose>-0.080 0 0.212 0 0 0</pose>
        <geometry><cylinder><radius>0.024</radius><length>0.185</length></cylinder></geometry>
        <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.45 0.47 0.50 1</diffuse></material>
      </visual>
      <visual name="lidar_body">
        <pose>-0.080 0 0.330 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.055</length></cylinder></geometry>
        <material><ambient>0.06 0.07 0.09 1</ambient><diffuse>0.10 0.12 0.15 1</diffuse></material>
      </visual>
      <visual name="camera_housing">
        <pose>0.295 0 0.090 0 0 0</pose>
        <geometry><box><size>0.050 0.110 0.055</size></box></geometry>
        <material><ambient>0.02 0.03 0.04 1</ambient><diffuse>0.05 0.06 0.08 1</diffuse></material>
      </visual>

<!-- @LINKS -->
    <!--
      mu2 well below mu for the same reason as the Bunker's tracks: a skid-steer
      turns by scrubbing sideways, and equal friction makes that either free or
      impossible.
    -->
    <link name="wheel_front_left">
      <pose>0.2255 0.245 -0.035 -1.5708 0 0</pose>
      <inertial><mass>1.2</mass>
        <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.006</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>0.30</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_front_right">
      <pose>0.2255 -0.245 -0.035 -1.5708 0 0</pose>
      <inertial><mass>1.2</mass>
        <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.006</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>0.30</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_rear_left">
      <pose>-0.2255 0.245 -0.035 -1.5708 0 0</pose>
      <inertial><mass>1.2</mass>
        <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.006</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>0.30</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_rear_right">
      <pose>-0.2255 -0.245 -0.035 -1.5708 0 0</pose>
      <inertial><mass>1.2</mass>
        <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.006</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <surface><friction><ode><mu>1.3</mu><mu2>0.30</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0875</radius><length>0.060</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
      </visual>
    </link>

    <joint name="joint_left" type="revolute">
      <parent>base_link</parent><child>wheel_front_left</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="joint_right" type="revolute">
      <parent>base_link</parent><child>wheel_front_right</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="joint_rear_left" type="revolute">
      <parent>base_link</parent><child>wheel_rear_left</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="joint_rear_right" type="revolute">
      <parent>base_link</parent><child>wheel_rear_right</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

<!-- @DRIVE -->
    <!--
      Both wheels on a side are given to the plugin, so all four are actually
      driven rather than dragged. wheel_separation is the track width, which is
      the correct turn geometry for a skid steer commanded in linear/angular.
    -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_left</left_joint>
      <left_joint>joint_rear_left</left_joint>
      <right_joint>joint_right</right_joint>
      <right_joint>joint_rear_right</right_joint>
      <wheel_separation>0.490</wheel_separation>
      <wheel_radius>0.0875</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>{{NAME}}/cmd_vel</topic>
      <odom_topic>{{NAME}}/odom</odom_topic>
      <tf_topic>{{NAME}}/tf</tf_topic>
      <frame_id>{{NAME}}/odom</frame_id>
      <child_frame_id>{{NAME}}/base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
