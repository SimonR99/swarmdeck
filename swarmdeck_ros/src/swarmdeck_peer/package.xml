<?xml version="1.0"?>
<package format="3">
  <name>swarmdeck_peer</name>
  <version>0.1.0</version>
  <description>
    Onboard peer runtime: the Swarm-SLAM bridge, its launch file and the MOLA
    product worker. The ROS-free contracts it builds on live in autonomy/.
  </description>
  <maintainer email="swarmdeck@mistlab.ca">SwarmDeck</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>cslam</exec_depend>
  <exec_depend>cslam_common_interfaces</exec_depend>
  <exec_depend>swarmdeck_cslam</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
