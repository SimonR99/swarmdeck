# SwarmDeck backend — ROS-free FastAPI server (also runs the mock adapter).
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Preserve repo layout: swarmdeck_server resolves REPO as parents[3] of api/app.py
COPY server/pyproject.toml /app/server/pyproject.toml
COPY server/swarmdeck_server /app/server/swarmdeck_server
COPY server/tests /app/server/tests
COPY study /app/study
COPY adapters /app/adapters
RUN mkdir -p /app/sessions

WORKDIR /app/server
RUN pip install -e ".[dev]"

WORKDIR /app
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/api/config >/dev/null || exit 1

CMD ["python", "-m", "swarmdeck_server", "--host", "0.0.0.0", "--port", "8080"]
