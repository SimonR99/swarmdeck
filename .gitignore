venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.svelte-kit/
*.tsbuildinfo

# ROS 2
build/
install/
log/

# Sessions (recorded output)
sessions/*
!sessions/.gitkeep

# Replay ablation output (slam/tools/replay.py writes replay/<dataset>/ by
# default). Generated from a capture plus a config name, so it is reproducible
# rather than worth versioning -- and it lands as a new PNG per ablation run,
# which is how three of them were committed by accident.
slam/replay/

