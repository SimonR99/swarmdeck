+++ b/cslam/include/cslam/back_end/unchanged_graph.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <gtsam/nonlinear/NonlinearFactorGraph.h>
+#include <gtsam/nonlinear/Values.h>
+#include <cstdint>
+#include <vector>
+
+namespace cslam {
+// Compare the collected graph, not just local counters: a stationary optimizer
+// must still solve when a remote robot adds a keyframe or loop closure.
+class UnchangedGraph {
+ public:
+  bool matches(const gtsam::NonlinearFactorGraph::shared_ptr& graph,
+               const gtsam::Values::shared_ptr& values,
+               const std::vector<uint64_t>& epochs, unsigned int origin) const {
+    return graph_ && epochs == epochs_ && origin == origin_ &&
+           graph_->equals(*graph, 0.0) && values_->equals(*values, 0.0);
+  }
+
+  void remember(const gtsam::NonlinearFactorGraph::shared_ptr& graph,
+                const gtsam::Values::shared_ptr& values,
+                const std::vector<uint64_t>& epochs, unsigned int origin,
+                const gtsam::Values& result) {
+    // Inputs are immutable once dispatched to the async optimizer.
+    graph_ = graph;
+    values_ = values;
+    epochs_ = epochs;
+    origin_ = origin;
+    result_ = result;
+  }
+
+  const gtsam::Values& result() const { return result_; }
+
+ private:
+  gtsam::Values result_;
+  gtsam::NonlinearFactorGraph::shared_ptr graph_;
+  gtsam::Values::shared_ptr values_;
+  std::vector<uint64_t> epochs_;
+  unsigned int origin_ = 0;
+};
+}  // namespace cslam
