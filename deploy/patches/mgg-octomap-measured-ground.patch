+TEST(OctomapMap, ZeroMaxRangeClipsEveryNonzeroEndpointForMetadata) {
+  OctomapConfig cfg;
+  cfg.resolution = 0.15;
+  cfg.max_range = 0.0;
+  OctomapMap map(cfg);
+  map.setTrackMeasuredSurfaceZ(true);
