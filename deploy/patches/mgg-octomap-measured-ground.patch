+          octomap::point3d(sample.x(), sample.y(), sample.z()));
+      const auto* b = tracked.tree()->search(
+          octomap::point3d(sample.x(), sample.y(), sample.z()));
+      ASSERT_EQ(a == nullptr, b == nullptr);
+      if (a != nullptr && b != nullptr) {
+        EXPECT_FLOAT_EQ(a->getLogOdds(), b->getLogOdds());
+      }
+    }
+  }
+}
