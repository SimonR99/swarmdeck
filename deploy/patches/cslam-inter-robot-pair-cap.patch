+    def robot_pair(self, robot0_id, robot1_id):
+        """ Unordered robot pair key
+
+        Args:
+            robot0_id (int): robot ID
+            robot1_id (int): robot ID
+
+        Returns:
+            tuple(int, int): the two IDs in ascending order
+        """
+        return (min(robot0_id, robot1_id), max(robot0_id, robot1_id))
+
+    def is_pair_capped(self, robot0_id, robot1_id):
+        """ Check whether a robot pair already holds enough accepted
+            inter-robot loop closures. A cap of zero or less means no cap.
+
+        Args:
+            robot0_id (int): robot ID
+            robot1_id (int): robot ID
+
+        Returns:
+            bool: no further candidates are wanted for this pair
+        """
+        cap = self.params["frontend.inter_robot_closure_pair_cap"]
+        if cap <= 0:
+            return False
+        return self.inter_robot_closures_per_pair.get(
+            self.robot_pair(robot0_id, robot1_id), 0) >= cap
+
+    def drop_capped_pair_candidates(self):
+        """ Withdraw the candidates of every capped robot pair from selection
+
+        Every accepted closure costs a registration, a pose graph
+        optimization and a solution broadcast, and a pair that is already
+        linked gains nothing from another one. The selector's in-range dict
+        is keyed by robot and the broker selects for every pair of the
+        fleet, so a robot cannot be marked out of range without also losing
+        its uncapped pairs. Dropping the candidates as already considered is
+        exact per pair; matches that arrive later on a capped pair are
+        dropped again at the next detection.
+        """
+        capped = [
+            e for e in self.lcm.candidate_selector.candidate_edges.values()
+            if self.is_pair_capped(e.robot0_id, e.robot1_id)
+        ]
+        if len(capped) > 0:
+            self.lcm.candidate_selector.remove_candidate_edges(capped)
+
