+def _quaternion_rotation(q):
+    norm = float(np.sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w))
+    if not np.isfinite(norm) or norm <= 1e-12:
+        return None
+    x, y, z, w = (q.x / norm, q.y / norm, q.z / norm, q.w / norm)
+    return np.array([
+        [1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - z * w),
+         2.0 * (x * z + y * w)],
+        [2.0 * (x * y + z * w), 1.0 - 2.0 * (x * x + z * z),
+         2.0 * (y * z - x * w)],
+        [2.0 * (x * z - y * w), 2.0 * (y * z + x * w),
+         1.0 - 2.0 * (x * x + y * y)],
+    ])
+
+
+def _pose_matrix(odom):
+    pose = odom.pose.pose
+    rotation = _quaternion_rotation(pose.orientation)
+    if rotation is None:
+        return None
+    matrix = np.eye(4)
+    matrix[:3, :3] = rotation
+    matrix[:3, 3] = (float(pose.position.x), float(pose.position.y),
+                     float(pose.position.z))
+    return matrix
+
+
+def _transform_matrix(transform):
+    rotation = _quaternion_rotation(transform.rotation)
+    if rotation is None:
+        return None
+    matrix = np.eye(4)
+    matrix[:3, :3] = rotation
+    matrix[:3, 3] = (float(transform.translation.x),
+                     float(transform.translation.y),
+                     float(transform.translation.z))
+    return matrix
+
+
+def _rotation_angle(rotation):
+    cosine = np.clip((float(np.trace(rotation)) - 1.0) / 2.0, -1.0, 1.0)
+    return float(np.arccos(cosine))
+
+
+def registration_odom_consistent(odom0, odom1, transform,
+                                 path_length_m=0.0,
+                                 max_sigma=5.0,
+                                 translation_floor_m=0.25,
+                                 translation_sigma_per_m=0.10,
+                                 rotation_floor_rad=0.05,
+                                 rotation_sigma_per_m=0.005,
+                                 max_rotation_error_rad=2.35619449019):
+    """Reject scan matches that contradict local odometry too strongly.
+
+    ``transform`` is the BetweenFactor measurement, namely pose 0 to pose 1.
+    Registration can correct accumulated drift, so the uncertainty envelope
+    grows with the odometry path between keyframes and with reported pose
+    covariance. Full SE3 is compared here: a valid ramp revisit may retain
+    roll/pitch, while a 180 degree tunnel ambiguity is not accumulated drift.
+    """
+    odom0_matrix = _pose_matrix(odom0)
+    odom1_matrix = _pose_matrix(odom1)
+    registration = _transform_matrix(transform)
+    if odom0_matrix is None or odom1_matrix is None or registration is None:
+        return False
+    odom_relative = np.linalg.inv(odom0_matrix) @ odom1_matrix
+    translation_error = float(np.linalg.norm(
+        registration[:3, 3] - odom_relative[:3, 3]))
+    rotation_error = _rotation_angle(
+        odom_relative[:3, :3].T @ registration[:3, :3])
+
+    path = abs(float(path_length_m))
+    path = max(path, float(np.linalg.norm(odom_relative[:3, 3])))
+    translation_sigma = max(float(translation_floor_m),
+                            float(translation_sigma_per_m) * path)
+    rotation_sigma = max(float(rotation_floor_rad),
+                         float(rotation_sigma_per_m) * path)
+
+    # Use supplied covariance when the sensor provides it, while retaining a
+    # path-length process-noise floor for captures that omit covariance.
+    for odom in (odom0, odom1):
+        covariance = getattr(getattr(odom, "pose", None), "covariance", None)
+        if covariance is None or len(covariance) < 36:
+            continue
+        try:
+            translation_sigma = max(
+                translation_sigma,
+                float(np.sqrt(max(0.0, float(covariance[0]),
+                                   float(covariance[7]),
+                                   float(covariance[14])))))
+            rotation_sigma = max(
+                rotation_sigma,
+                float(np.sqrt(max(0.0, float(covariance[21]),
+                                   float(covariance[28]),
+                                   float(covariance[35])))))
+        except (TypeError, ValueError):
+            continue
+
+    return (translation_error <= float(max_sigma) * translation_sigma and
+            rotation_error <= min(float(max_rotation_error_rad),
+                                  float(max_sigma) * rotation_sigma))
+
