+          for (const mgg::XYCellCenter& cell : footprint) {
+            Eigen::Vector3d hit;
+            const VoxelStatus status = provider.getGroundRayStatus(
+                {cell.center.x(), cell.center.y(), point.z()},
+                {cell.center.x(), cell.center.y(), point.z() - 1.0}, false,
