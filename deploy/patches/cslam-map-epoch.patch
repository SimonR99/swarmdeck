+void DecentralizedPGO::invalidate_robot(unsigned int rid)
+{
+  ++epoch_generation_;
+  other_robots_graph_and_estimates_.erase(rid);
+  received_pose_graphs_[rid] = false;
+  received_pose_graphs_connectivity_.erase(rid);
+  for (auto& item : received_pose_graphs_connectivity_) {
+    auto& ids = item.second;
+    ids.erase(std::remove(ids.begin(), ids.end(), rid), ids.end());
+  }
+  // A peer copy can contain closures involving the retired robot as well.
+  // Its own values and every unrelated factor are retained.
+  for (auto& item : other_robots_graph_and_estimates_) {
+    auto retained = boost::make_shared<gtsam::NonlinearFactorGraph>();
+    for (const auto& factor : *item.second.first) {
+      bool touches = false;
+      for (auto key : factor->keys())
+        touches |= ROBOT_ID(gtsam::LabeledSymbol(key).label()) == rid;
+      if (!touches) retained->push_back(factor);
+    }
+    item.second.first = retained;
+  }
+  for (auto& pair : inter_robot_loop_closures_)
+    if (pair.first.first == rid || pair.first.second == rid) pair.second.clear();
+  connected_robots_.erase(rid);
+  current_neighbors_ids_.robots.ids.clear();
+  current_neighbors_ids_.origins.ids.clear();
+  end_waiting();
+  // Do not replace or destroy an active future (which would block the executor).
+  // Its immutable inputs remain alive; the generation gate drops its result.
+  if (optimizer_state_ != OptimizerState::OPTIMIZATION)
+    optimizer_state_ = OptimizerState::IDLE;
+  if (solution_participants_.count(rid) || origin_robot_id_ == rid)
+    publish_local_solution();
+}
