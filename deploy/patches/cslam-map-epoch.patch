+namespace cslam {
+// Used only from the node's serialized ROS callbacks; the optimizer never mutates it.
+class EpochFence {
+ public:
+  EpochFence(const std::shared_ptr<rclcpp::Node>& node, const std::string& role,
+             std::function<void(unsigned int)> on_advance = {})
+      : on_advance_(std::move(on_advance)) {
+    mission_ = node->get_parameter("swarmdeck.mission_id").as_string();
+    const auto local = node->get_parameter("robot_id").as_int();
+    const auto count = node->get_parameter("max_nb_robots").as_int();
+    const auto epoch = node->get_parameter("swarmdeck.map_epoch").as_int();
+    if (mission_.empty() || local < 0 || local >= count || epoch < 0)
+      throw std::runtime_error("invalid mission/map epoch configuration");
+    robot_ = local;
+    epoch_ = epoch;
+    epochs_.assign(count, 0);
+    const auto prefix = node->get_parameter("swarmdeck.epoch_state_path").as_string();
+    if (!prefix.empty()) {
+      path_ = prefix + "." + role + ".json";
+      errno = 0;
+      std::ifstream input(path_);
+      if (input) {
+        boost::property_tree::ptree state;
+        boost::property_tree::read_json(input, state);
+        if (state.get<std::string>("mission_id") != mission_ ||
+            state.get<unsigned int>("robot_id") != robot_)
+          throw std::runtime_error("peer epoch state identity mismatch");
+        std::vector<uint64_t> saved;
+        for (const auto& item : state.get_child("robot_map_epochs")) {
+          const auto value = item.second.get_value<std::string>();
+          if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos)
+            throw std::runtime_error("invalid persisted map epoch");
+          saved.push_back(item.second.get_value<uint64_t>());
+        }
+        if (saved.size() != epochs_.size() || saved[robot_] > epoch_)
+          throw std::runtime_error("invalid persisted peer epoch watermarks");
+        epochs_ = std::move(saved);
+      } else if (errno != ENOENT) {
+        throw std::runtime_error("cannot read peer epoch state: " + path_);
+      }
+    }
+    epochs_[robot_] = epoch_;
+    persist(epochs_);
+    for (unsigned int rid = 0; rid < epochs_.size(); ++rid) {
+      subscriptions_.push_back(node->create_subscription<cslam_common_interfaces::msg::RobotHeartbeat>(
+          "/r" + std::to_string(rid) + "/cslam/heartbeat", 10,
+          [this, rid](cslam_common_interfaces::msg::RobotHeartbeat::ConstSharedPtr msg) {
+            if (msg->robot_id == rid && msg->publisher_robot_id == rid)
+              accept(*msg, {msg->origin_robot_id});
+          }));
+    }
+  }
+
+  template<class Message> void stamp(Message& msg) const {
+    msg.mission_id = mission_;
+    msg.publisher_robot_id = robot_;
+    msg.map_epoch = epoch_;
+    msg.robot_map_epochs = epochs_;
+  }
+
+  template<class Message>
+  bool accept(const Message& msg, std::vector<unsigned int> participants = {}, bool local = false) {
+    const auto sender = msg.publisher_robot_id;
+    const auto& vector = msg.robot_map_epochs;
+    if (msg.mission_id != mission_ || sender >= epochs_.size() ||
+        vector.size() != epochs_.size() || vector[sender] != msg.map_epoch ||
+        (local && sender != robot_)) return false;
+    participants.push_back(sender);
+    std::sort(participants.begin(), participants.end());
+    participants.erase(std::unique(participants.begin(), participants.end()), participants.end());
+    for (auto rid : participants) {
+      if (rid >= epochs_.size() || vector[rid] < epochs_[rid] ||
+          (rid == robot_ && vector[rid] != epoch_)) return false;
+    }
+    std::vector<unsigned int> changed;
+    for (auto rid : participants)
+      if (vector[rid] > epochs_[rid]) changed.push_back(rid);
+    if (!changed.empty()) {
+      auto next = epochs_;
+      for (auto rid : changed) next[rid] = vector[rid];
+      persist(next); // Durable fence precedes any use of newly admitted geometry.
+      epochs_ = std::move(next);
+      for (auto rid : changed) if (on_advance_) on_advance_(rid);
+    }
+    return true;
+  }
+
+  const std::vector<uint64_t>& epochs() const { return epochs_; }
+
+ private:
+  void persist(const std::vector<uint64_t>& epochs) const {
+    if (path_.empty()) return;
+    boost::property_tree::ptree state, array;
+    state.put("mission_id", mission_);
+    state.put("robot_id", robot_);
+    for (auto epoch : epochs) {
+      boost::property_tree::ptree item;
+      item.put_value(epoch);
+      array.push_back({"", item});
+    }
+    state.add_child("robot_map_epochs", array);
+    std::ostringstream stream;
+    boost::property_tree::write_json(stream, state, false);
+    const auto bytes = stream.str();
+    const auto temporary = path_ + ".tmp";
+    int fd = ::open(temporary.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) throw std::runtime_error("cannot open peer epoch state: " + temporary);
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+      const auto written = ::write(fd, bytes.data() + offset, bytes.size() - offset);
+      if (written < 0 && errno == EINTR) continue;
+      if (written <= 0) { ::close(fd); throw std::runtime_error("cannot write peer epoch state"); }
+      offset += written;
+    }
+    const auto synced = ::fsync(fd);
+    const auto closed = ::close(fd);
+    if (synced || closed || ::rename(temporary.c_str(), path_.c_str()))
+      throw std::runtime_error("cannot persist peer epoch state");
+    const auto separator = path_.find_last_of('/');
+    const auto parent = separator == std::string::npos ? "." : path_.substr(0, separator);
+    fd = ::open(parent.c_str(), O_RDONLY | O_DIRECTORY);
+    if (fd < 0) throw std::runtime_error("cannot open peer epoch state directory");
+    const auto directory_synced = ::fsync(fd);
+    ::close(fd);
+    if (directory_synced) throw std::runtime_error("cannot sync peer epoch state directory");
+  }
+  std::string mission_, path_;
+  unsigned int robot_;
+  uint64_t epoch_;
+  std::vector<uint64_t> epochs_;
+  std::function<void(unsigned int)> on_advance_;
+  std::vector<rclcpp::Subscription<cslam_common_interfaces::msg::RobotHeartbeat>::SharedPtr> subscriptions_;
+};
+} // namespace cslam
+#endif
