+++ b/cslam/cslam/epoch_fence.py
@@ -0,0 +1,102 @@
+"""Mission-scoped map epochs. Persist before admitting geometry, fail closed on I/O."""
+import json
+import os
+from pathlib import Path
+import tempfile
+
+
+class EpochFence:
+    def __init__(self, mission, robot_id, map_epoch, count, path="", on_advance=None):
+        if not mission or not 0 <= robot_id < count or map_epoch < 0:
+            raise ValueError("invalid mission/map epoch configuration")
+        self.mission = mission
+        self.robot_id = robot_id
+        self.map_epoch = map_epoch
+        self.epochs = [0] * count
+        self.path = Path(path) if path else None
+        self.on_advance = on_advance
+        if self.path and self.path.exists():
+            state = json.loads(self.path.read_text())
+            epochs = state["robot_map_epochs"]
+            if (state["mission_id"] != mission or state["robot_id"] != robot_id
+                    or len(epochs) != count or any(type(e) is not int or not 0 <= e < 2**64 for e in epochs)
+                    or epochs[robot_id] > map_epoch):
+                raise ValueError("invalid persisted peer epoch watermarks")
+            self.epochs = epochs
+        self.epochs[robot_id] = map_epoch
+        self._persist(self.epochs)
+
+    @classmethod
+    def for_node(cls, node, role, on_advance=None):
+        from cslam_common_interfaces.msg import RobotHeartbeat
+        for name, default in (("swarmdeck.mission_id", ""), ("swarmdeck.map_epoch", 0),
+                              ("swarmdeck.epoch_state_path", ""), ("max_nb_robots", 1)):
+            if not node.has_parameter(name):
+                node.declare_parameter(name, default)
+        value = lambda name: node.get_parameter(name).value
+        prefix = value("swarmdeck.epoch_state_path")
+        fence = cls(value("swarmdeck.mission_id"), value("robot_id"),
+                    value("swarmdeck.map_epoch"), value("max_nb_robots"),
+                    prefix + "." + role + ".json" if prefix else "", on_advance)
+        fence.subscriptions = [node.create_subscription(
+            RobotHeartbeat, f"/r{rid}/cslam/heartbeat",
+            lambda msg, rid=rid: fence.heartbeat(msg, rid), 10)
+            for rid in range(len(fence.epochs))]
+        return fence
+
+    def _persist(self, epochs):
+        if not self.path:
+            return
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd, temporary = tempfile.mkstemp(dir=self.path.parent, prefix=self.path.name + ".")
+        try:
+            with os.fdopen(fd, "w") as stream:
+                json.dump({"mission_id": self.mission, "robot_id": self.robot_id,
+                           "robot_map_epochs": epochs}, stream)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, self.path)
+            directory = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+        finally:
+            if os.path.exists(temporary):
+                os.unlink(temporary)
+
+    def stamp(self, msg, epochs=None):
+        msg.mission_id = self.mission
+        msg.publisher_robot_id = self.robot_id
+        msg.map_epoch = self.map_epoch
+        msg.robot_map_epochs = self.epochs if epochs is None else epochs
+        return msg
+
+    def accept(self, msg, participants=(), local=False):
+        sender = msg.publisher_robot_id
+        vector = msg.robot_map_epochs
+        if (msg.mission_id != self.mission or not 0 <= sender < len(self.epochs)
+                or len(vector) != len(self.epochs) or vector[sender] != msg.map_epoch
+                or (local and sender != self.robot_id)):
+            return False
+        referenced = set(participants)
+        referenced.add(sender)
+        for rid in referenced:
+            if (not 0 <= rid < len(self.epochs) or vector[rid] < self.epochs[rid]
+                    or (rid == self.robot_id and vector[rid] != self.map_epoch)):
+                return False
+        changed = [rid for rid in referenced if vector[rid] > self.epochs[rid]]
+        if changed:
+            epochs = self.epochs.copy()
+            for rid in changed:
+                epochs[rid] = vector[rid]
+            self._persist(epochs)
+            self.epochs = epochs
+            for rid in changed:
+                if self.on_advance:
+                    self.on_advance(rid)
+        return True
+
+    def heartbeat(self, msg, rid):
+        return (msg.robot_id == rid and msg.publisher_robot_id == rid
+                and self.accept(msg, (msg.origin_robot_id,)))
