+#ifndef CSLAM_EPOCH_FENCE_H
+#define CSLAM_EPOCH_FENCE_H
+
+#include <rclcpp/rclcpp.hpp>
+#include <cslam_common_interfaces/msg/robot_heartbeat.hpp>
+#include <boost/property_tree/json_parser.hpp>
