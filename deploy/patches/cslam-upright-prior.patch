+  // Attitude prior for ground robots. Inter-robot closures from scan
+  // registration carry a fraction of a degree of pitch and roll error;
+  // without a prior the optimizer rotates a whole robot's chain to absorb
+  // it, and a 1.5 degree tilt of a robot's frame puts the shared map's floor
+  // 0.5 m off at 20 m from the frame origin, which the planner reads as
+  // steps, drops or occupied ground. Every pose whose odometry says it is
+  // level (gravity-aligned roll and pitch from the odometry's IMU, exact in
+  // simulation) keeps its body Z axis within sigma of the navigation Z axis;
+  // yaw and translation stay free. A pose the odometry reports tilted beyond
+  // upright_prior_level_max_rad, on a ramp or a kerb, gets no prior: its
+  // attitude follows the odometry factors to its level neighbours, so a
+  // slope is kept and a closure still cannot tilt the chain. The aggregate
+  // graph's initial values are the odometry poses of every robot, and
+  // gravity gives all their frames the same Z axis, so the level test needs
+  // no yaw alignment between robots.
+  if (upright_prior_sigma_rad_ > 0.0)
+  {
+    const auto upright_noise =
+        gtsam::noiseModel::Isotropic::Sigma(2, upright_prior_sigma_rad_);
+    const gtsam::Unit3 up(0.0, 0.0, 1.0);
+    const double level_cos = std::cos(upright_prior_level_max_rad_);
+    for (const auto &key_value : *aggregate_pose_graph_.second)
+    {
+      const gtsam::Pose3 odometry_pose =
+          aggregate_pose_graph_.second->at<gtsam::Pose3>(key_value.key);
+      const gtsam::Point3 body_up =
+          odometry_pose.rotation().rotate(gtsam::Point3(0.0, 0.0, 1.0));
+      if (body_up.z() < level_cos)
+      {
+        continue;
+      }
+      aggregate_pose_graph_.first->emplace_shared<gtsam::Pose3AttitudeFactor>(
+          key_value.key, up, upright_noise, up);
+    }
+  }
+
   if (enable_logs_){
     logger_->log_initial_global_pose_graph(aggregate_pose_graph_.first, aggregate_pose_graph_.second);
   }
