+  // Upright prior for ground robots on a planar site. Inter-robot closures
+  // from scan registration carry a fraction of a degree of pitch and roll
+  // error; without a prior the optimizer rotates a whole robot's chain to
+  // absorb it, and a 1.5 degree tilt of a robot's frame puts the shared map's
+  // floor 0.5 m off at 20 m from the frame origin, which the planner reads
+  // as steps, drops or occupied ground. Each pose keeps its body Z axis
+  // within sigma of the navigation Z axis; yaw and translation stay free.
+  if (upright_prior_sigma_rad_ > 0.0)
+  {
+    const auto upright_noise =
+        gtsam::noiseModel::Isotropic::Sigma(2, upright_prior_sigma_rad_);
+    const gtsam::Unit3 up(0.0, 0.0, 1.0);
+    for (const auto &key_value : *aggregate_pose_graph_.second)
+    {
+      aggregate_pose_graph_.first->emplace_shared<gtsam::Pose3AttitudeFactor>(
+          key_value.key, up, upright_noise, up);
+    }
+  }
+
   if (enable_logs_){
     logger_->log_initial_global_pose_graph(aggregate_pose_graph_.first, aggregate_pose_graph_.second);
   }
