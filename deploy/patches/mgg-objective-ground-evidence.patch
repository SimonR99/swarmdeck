+  EXPECT_EQ(classify({0.10, 0.0, 0.0}), VoxelStatus::kOccupied);
+  EXPECT_EQ(classify({0.25, 0.0, 0.0}), VoxelStatus::kOccupied);
+  EXPECT_EQ(classify({0.10, 0.05, 0.0}), VoxelStatus::kOccupied);
