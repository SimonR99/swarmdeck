+    @staticmethod
+    def scene_signature(points, bins):
+        """Minimum planar range per azimuth bin, inf where a bin is empty."""
+        signature = np.full(bins, np.inf)
+        if points is None or len(points) == 0:
+            return signature
+        xy = np.asarray(points, dtype=float)[:, :2]
+        ranges = np.hypot(xy[:, 0], xy[:, 1])
+        finite = np.isfinite(ranges) & (ranges > 0.0)
+        if not finite.any():
+            return signature
+        azimuth = np.arctan2(xy[finite, 1], xy[finite, 0])
+        index = ((azimuth + np.pi) / (2.0 * np.pi) * bins).astype(int) % bins
+        np.minimum.at(signature, index, ranges[finite])
+        return signature
+
+    @staticmethod
+    def scene_changed(previous, current, range_m, fraction):
+        """True when enough azimuth bins moved by more than range_m.
+
+        A bin that was empty and now has a return (or the reverse) counts as
+        changed: that is what a neighbour driving out of the way looks like
+        once its returns are masked or gone.
+        """
+        if previous is None or fraction <= 0.0 or range_m <= 0.0:
+            return False
+        both = np.isfinite(previous) & np.isfinite(current)
+        moved = both & (np.abs(previous - current) > range_m)
+        appeared = np.isfinite(previous) != np.isfinite(current)
+        return float(np.count_nonzero(moved | appeared)) >= fraction * len(current)
+
