+double boundedRetryDelaySeconds(int attempt, double initial, double maximum) {
+  double delay = initial;
+  for (int n = 1; n < attempt && delay < maximum; ++n) {
+    delay = std::min(maximum, delay * 2.0);
+  }
+  return delay;
+}
