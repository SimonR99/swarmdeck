+TEST(GridRefinement, SparsePartialProxyFindsSupportedCorridorEndpoint) {
+  RouteCorridor route = routeTo(8.0, 0.0);
+  route.request.objective = mgg::ObjectiveKind::kNavigate;
+  route.partial = true;
+  route.poses = {StateVec(1.0, 0.0, 0.0, 0.0),
+                 StateVec(4.0, 0.0, 0.0, 0.0)};
+  auto project = [](StateVec& state, const StateVec*) {
+    return state.x() <= 2.0 + 1e-9
+               ? GridProjectionStatus::kSupported
+               : GridProjectionStatus::kNoGround;
+  };
+  GridRefinementLimits bounded = limits();
+  bounded.partial_min_progress_m = 1.5;
+  BoundedGridPlanner planner(StateVec::Zero(), bounded, project,
+                             sampledTraversal({}));
+
+  const FeasiblePath path = planner.refine(route);
+  ASSERT_EQ(path.status, PlanningStatus::kSucceeded) << path.reason;
+  ASSERT_TRUE(path.partial);
+  ASSERT_FALSE(path.poses.empty());
+  EXPECT_NEAR(path.poses.back().x(), 2.0, 1e-9);
+  EXPECT_GT(path.poses.back().x(), route.poses.front().x());
+}
+
+TEST(GridRefinement, SparsePartialProxyNearStartFailsWithoutProgress) {
+  RouteCorridor route = routeTo(8.0, 0.0);
+  route.request.objective = mgg::ObjectiveKind::kNavigate;
+  route.partial = true;
+  route.poses = {StateVec(0.05, 0.0, 0.0, 0.0),
+                 StateVec(4.0, 0.0, 0.0, 0.0)};
+  auto project = [](StateVec& state, const StateVec*) {
+    return state.x() <= 0.05 + 1e-9
+               ? GridProjectionStatus::kSupported
+               : GridProjectionStatus::kNoGround;
+  };
+  BoundedGridPlanner planner(StateVec::Zero(), limits(), project,
+                             sampledTraversal({}));
+
+  const FeasiblePath path = planner.refine(route);
+  EXPECT_EQ(path.status, PlanningStatus::kBlocked);
+  EXPECT_FALSE(path.partial);
+  EXPECT_TRUE(path.poses.empty());
+}
+
+TEST(GridRefinement, ProvisionalSparseProxyRecoversFromLiveStart) {
+  RouteCorridor route = routeTo(8.0, 0.0);
+  route.request.objective = mgg::ObjectiveKind::kNavigate;
+  route.partial = true;
+  route.poses = {StateVec(4.0, 0.0, 0.0, 0.0)};
+  auto project = [](StateVec& state, const StateVec*) {
+    if (state.x() <= 2.0 + 1e-9) {
+      state.z() = 0.0;
+      return GridProjectionStatus::kSupported;
+    }
+    return GridProjectionStatus::kProvisionalUnknown;
+  };
+  BoundedGridPlanner planner(StateVec::Zero(), limits(), project,
+                             sampledTraversal({}));
+
+  const FeasiblePath path = planner.refine(route);
+  ASSERT_EQ(path.status, PlanningStatus::kSucceeded) << path.reason;
+  ASSERT_TRUE(path.partial);
+  ASSERT_FALSE(path.poses.empty());
+  EXPECT_NEAR(path.poses.back().x(), 2.0, 1e-9);
+}
