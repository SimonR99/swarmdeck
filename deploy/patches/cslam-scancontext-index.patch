+    def _candidate_indices(self, ringkey_query):
+        # A copied tree owns stable data across ringkeys.resize(). Newly added
+        # descriptors remain searchable immediately in a bounded exact tail.
+        if self.ringkey_tree is None or self.nb_items - self.indexed_items >= 64:
+            self.ringkey_tree = spatial.KDTree(
+                self.ringkeys[: self.nb_items], copy_data=True
+            )
+            self.indexed_items = self.nb_items
+        count = min(self.num_candidates, self.nb_items)
+        distances, indices = self.ringkey_tree.query(
+            ringkey_query, k=min(count + 1, self.indexed_items)
+        )
+        distances, indices = np.atleast_1d(distances), np.atleast_1d(indices)
+        tail_indices = np.arange(self.indexed_items, self.nb_items)
+        tail_distances = np.linalg.norm(
+            self.ringkeys[self.indexed_items : self.nb_items] - ringkey_query, axis=1
+        )
+        distances = np.concatenate((distances, tail_distances))
+        indices = np.concatenate((indices, tail_indices))
+        order = np.argsort(distances)
+        # KDTree's equal-distance tie order depends on its full tree layout.
+        # Preserve the old candidates (and therefore scores) for those ties.
+        nearest = distances[order[: count + 1]]
+        # NumPy tail norms and KDTree norms may differ by a few ulps even
+        # for identical ring keys. Conservatively rebuild for near ties too.
+        if len(nearest) > 1 and np.any(
+            np.isclose(nearest[1:], nearest[:-1], rtol=1e-14, atol=0.0)
+        ):
+            tree = spatial.KDTree(self.ringkeys[: self.nb_items])
+            return np.atleast_1d(tree.query(ringkey_query, k=count)[1])
+        return indices[order[:count]]
 
