+// Immutable MOLA planner snapshots exposed through MapInterface.
+
+#ifndef MGG_MAP_OCTOMAP_MOLA_MAP_H_
+#define MGG_MAP_OCTOMAP_MOLA_MAP_H_
+
+#include <chrono>
