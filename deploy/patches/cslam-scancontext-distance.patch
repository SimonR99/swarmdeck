+    # Normalize each column once, then score every column pairing together.
+    # Each cyclic diagonal represents one of the original 1..num_sectors shifts.
+    norms1 = np.linalg.norm(sc1, axis=0)
+    norms2 = np.linalg.norm(sc2, axis=0)
+    valid1, valid2 = norms1 != 0, norms2 != 0
+    normalized1 = sc1 / np.where(valid1, norms1, 1.0)
+    normalized2 = sc2 / np.where(valid2, norms2, 1.0)
+    column_similarities = normalized1.T @ normalized2
+    sectors = sc1.shape[1]
+    columns = np.arange(sectors)
+    shifted = (columns[None, :] - np.arange(1, sectors + 1)[:, None]) % sectors
+    engaged = valid1[shifted] & valid2[columns]
+    totals = np.where(engaged, column_similarities[shifted, columns], 0.0).sum(axis=1)
+    counts = engaged.sum(axis=1)
+    similarities = np.divide(totals, counts, out=np.zeros(sectors), where=counts != 0)
+    yaw_diff = np.argmax(similarities) + 1
+    return 1 - similarities[yaw_diff - 1], yaw_diff
