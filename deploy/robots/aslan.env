# Aslan deployment profile. This file is sourced by scripts/deploy on the
# operator workstation; values can be overridden inline:
#   BACKEND_HOST=192.168.1.10 make deploy ROBOT=aslan

: "${DEPLOY_SSH_HOST:=aslan@aslan.local}"
: "${DEPLOY_REMOTE_REPO:=/ssd/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-aslan.yml}"
: "${DEPLOY_PRE_BUILD_SCRIPT:=scripts/aslan-build-overlay}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-aslan-adapter swarmdeck-aslan-media}"
: "${DEPLOY_ROBOT_ID:=aslan_0}"

: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${ASLAN_MIST_WS:=/ssd/mist_ws_ros2}"
: "${ASLAN_OVERLAY:=$DEPLOY_REMOTE_REPO/.aslan_ros}"
: "${ASLAN_ROS_IMAGE:=bunker:dev}"
: "${ASLAN_ROS_DOMAIN_ID:=49}"
: "${ASLAN_CAN_INTERFACE:=can2}"
# Aslan carries the same OAK-D as Botman. Its camera mount is approximately
# z=-0.04 m relative to os_lidar. Replace this estimate with a measured mount
# when available.
: "${ASLAN_OAK_PARAMS:=botman_oak_rgbd.yaml}"
: "${ASLAN_OAK_X:=0.03}"
: "${ASLAN_OAK_Y:=0.00}"
: "${ASLAN_OAK_Z:=-0.04}"
: "${ASLAN_OAK_ROLL:=0}"
: "${ASLAN_OAK_PITCH:=0}"
# OAK faces the physical-forward base frame.
: "${ASLAN_OAK_YAW:=0}"

# SuperOdometry configuration (VectorNav VN-100).
#
# THE FOUR KEYS BELOW MOVE TOGETHER. The IMU topic, the VectorNav driver and
# the two SuperOdometry files (which carry that IMU's extrinsics and noise
# densities) have to agree: a config naming one IMU while the topic carries
# another diverges with no error message. Nor does a missing IMU fail loudly,
# SuperOdometry logs "no IMU data, running LiDAR Odometry only" and quietly
# degrades to lidar-only odometry, so dropping ASLAN_START_VECTORNAV costs
# quality without costing a startup error.
#
# WHY THE VN-100. It is the quieter part, and SuperOdometry is IMU-first: it
# falls back to IMU-only propagation whenever a scan is late or missing, so the
# IMU sets the floor on odometry quality. Measured on botman 2026-09-03, the
# VN-100 is 3.5x quieter in acceleration and 6.9x quieter in rate than the
# Ouster's internal part, with a static gyro bias of 0.0003 deg/s against
# 0.696 deg/s.
#
# The mounting rotation was MEASURED 2026-09-01 by
# scripts/calibration/run_aslan_calibration.py (the VN-100's gyro against the
# Ouster's, composed with the Ouster's factory os_lidar -> os_imu transform):
# os_lidar -> vectornav is roll -0.03, pitch -0.85, yaw -90.65 deg, residual
# RMS 0.0257 rad/s over 3416 samples. Identity would have been ~91 deg wrong,
# and so would the 180 deg that os_lidar's own mounting suggests. It lives in
# aslan_superodom_calibration.yaml.
#
# ASLAN_START_VECTORNAV starts the driver's two nodes and the os_lidar ->
# vectornav TF, and on Aslan those run inside the slam container from
# aslan_bunker.launch.py (Botman runs the same pair as its own Compose
# service). Two nodes are needed, not one: `vectornav` talks to the serial
# port, `vn_sensor_msgs` turns its raw registers into sensor_msgs/Imu on
# /vectornav/imu, which is what SuperOdometry subscribes to.
#
# The IMU's own noise densities and g_norm were measured on this unit
# 2026-09-04 over a 600 s static log (scripts/calibration/measure_imu_static.py)
# and live in aslan_superodom.yaml. g_norm in particular is this device's own
# static reading (9.7666) and is not transferable, not even from botman's
# VN-100; scripts/aslan-build-overlay still refuses to deploy a config that
# reverts to the upstream placeholder.
#
# To fall back to the Ouster IMU (factory-exact extrinsic, no estimation
# involved), override all four together rather than editing these defaults:
#   ASLAN_IMU_TOPIC=/ouster/imu
#   ASLAN_START_VECTORNAV=false
#   ASLAN_SUPERODOM_CONFIG=aslan_superodom_ouster.yaml
#   ASLAN_SUPERODOM_CALIB=aslan_superodom_ouster_calibration.yaml
#
# Odometry backend selection:
# Options: superodometry | fast_livo2 | ekf | native
: "${ASLAN_ODOMETRY_BACKEND:=superodometry}"
: "${ASLAN_IMU_TOPIC:=/vectornav/imu}"
: "${ASLAN_START_VECTORNAV:=true}"
: "${ASLAN_SUPERODOM_CONFIG:=aslan_superodom.yaml}"
: "${ASLAN_SUPERODOM_CALIB:=aslan_superodom_calibration.yaml}"

DEPLOY_ENV_KEYS="
  ROBOT_REPO ASLAN_MIST_WS ASLAN_OVERLAY ASLAN_ROS_IMAGE
  ASLAN_ROS_DOMAIN_ID ASLAN_CAN_INTERFACE ASLAN_OAK_PARAMS
  ASLAN_OAK_X ASLAN_OAK_Y ASLAN_OAK_Z
  ASLAN_OAK_ROLL ASLAN_OAK_PITCH ASLAN_OAK_YAW
  ASLAN_ODOMETRY_BACKEND ASLAN_IMU_TOPIC ASLAN_START_VECTORNAV ASLAN_SUPERODOM_CONFIG ASLAN_SUPERODOM_CALIB
"
