# Aslan deployment profile. This file is sourced by scripts/deploy on the
# operator workstation; values can be overridden inline:
#   BACKEND_HOST=192.168.1.10 make deploy ROBOT=aslan

: "${DEPLOY_SSH_HOST:=aslan@192.168.1.139}"
: "${DEPLOY_REMOTE_REPO:=/ssd/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-aslan.yml}"
: "${DEPLOY_PRE_BUILD_SCRIPT:=scripts/aslan-build-overlay}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-aslan-adapter swarmdeck-aslan-media}"

: "${BACKEND_HOST:=192.168.1.161}"
: "${BACKEND_PORT:=8080}"
: "${ASLAN_REPO:=$DEPLOY_REMOTE_REPO}"
: "${ASLAN_MIST_WS:=/ssd/mist_ws_ros2}"
: "${ASLAN_OVERLAY:=$DEPLOY_REMOTE_REPO/.aslan_ros}"
: "${ASLAN_ROS_IMAGE:=bunker:dev}"
: "${ASLAN_ROS_DOMAIN_ID:=49}"
: "${ASLAN_CAN_INTERFACE:=can2}"
: "${ASLAN_OAK_PARAMS:=botman_oak_rgb.yaml}"

DEPLOY_ENV_KEYS="
  BACKEND_HOST BACKEND_PORT
  ASLAN_REPO ASLAN_MIST_WS ASLAN_OVERLAY ASLAN_ROS_IMAGE
  ASLAN_ROS_DOMAIN_ID ASLAN_CAN_INTERFACE ASLAN_OAK_PARAMS
  MEDIA_HOST MEDIA_RTSP_PORT VIDEO_BITRATE_KBPS VIDEO_FPS
"
