# Asimov (Unitree G1) deployment profile.
# Sourced by scripts/deploy for Asimov on 192.168.1.37 (user unitree).

: "${DEPLOY_SSH_HOST:=asimov}"
: "${DEPLOY_REMOTE_REPO:=/home/unitree/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-asimov.yml}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-asimov-adapter swarmdeck-asimov-media}"
: "${DEPLOY_ROBOT_ID:=asimov_0}"

: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${ASIMOV_WORKSPACE:=/home/unitree/workspaces}"
: "${ASIMOV_ROS_IMAGE:=ros:humble}"
: "${ASIMOV_ROS_DOMAIN_ID:=0}"
: "${ASIMOV_INTERFACE:=eth0}"
: "${ASIMOV_ROS_WORKSPACE:=/home/unitree/workspaces/unitree_g1_ros2}"
: "${ASIMOV_NATIVE_LOG:=/tmp/swarmdeck-asimov-g1-bridge.log}"

# The ROS 2 Humble containers own the camera and SwarmDeck adapter. The
# installed Foxy/Unitree bridge on Asimov owns locomotion, odometry, state, and
# TF, so it must be started on the robot host after Compose is refreshed.
: "${DEPLOY_OPERATOR_UP_SCRIPT:=scripts/asimov-up}"
: "${DEPLOY_OPERATOR_UP_KEYS:=
  DEPLOY_REMOTE_REPO DEPLOY_COMPOSE_FILE DEPLOY_ROBOT_ID
  BACKEND_HOST BACKEND_PORT
  ASIMOV_WORKSPACE ASIMOV_ROS_DOMAIN_ID ASIMOV_INTERFACE ASIMOV_ROS_WORKSPACE
  ASIMOV_NATIVE_LOG ASIMOV_NATIVE_RESET ASIMOV_CONTAINER_RESET
}"

# Odometry backend selection:
# Options: native | superodometry | fast_livo2 | ekf
: "${ASIMOV_ODOMETRY_BACKEND:=native}"

DEPLOY_ENV_KEYS="
  ROBOT_REPO ASIMOV_WORKSPACE ASIMOV_ROS_IMAGE ASIMOV_ROS_DOMAIN_ID
  ASIMOV_INTERFACE ASIMOV_ROS_WORKSPACE ASIMOV_NATIVE_LOG
  ASIMOV_ODOMETRY_BACKEND
"
