# Spot deployment profile. The MIST workspace and both prebuilt Spot images
# live on the payload; SwarmDeck builds only the images defined in this repo.

: "${DEPLOY_SSH_HOST:=spot}"
: "${DEPLOY_REMOTE_REPO:=/home/indro/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-spot.yml}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-spot-adapter swarmdeck-spot-media}"

: "${BACKEND_HOST:=192.168.1.161}"
: "${BACKEND_PORT:=8080}"
: "${SPOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${SPOT_WORKSPACE:=/home/indro/mist_ws_ros2}"
: "${SPOT_IMAGE:=spot:dev}"
: "${SPOT_SLAM_IMAGE:=spot_lio_sam:dev}"
: "${SPOT_ROS_DOMAIN_ID:=0}"

DEPLOY_ENV_KEYS="
  BACKEND_HOST BACKEND_PORT
  SPOT_REPO SPOT_WORKSPACE SPOT_IMAGE SPOT_SLAM_IMAGE SPOT_ROS_DOMAIN_ID
  MEDIA_HOST MEDIA_RTSP_PORT VIDEO_BITRATE_KBPS VIDEO_FPS
"
