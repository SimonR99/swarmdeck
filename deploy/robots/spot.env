# Spot deployment profile. The MIST workspace and both prebuilt Spot images
# live on the payload; SwarmDeck builds only the images defined in this repo.

: "${DEPLOY_SSH_HOST:=spot}"
: "${DEPLOY_REMOTE_REPO:=/home/indro/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-spot.yml}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-spot-camera swarmdeck-spot-adapter swarmdeck-spot-media}"
: "${DEPLOY_ROBOT_ID:=spot_0}"

: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${SPOT_WORKSPACE:=/home/indro/mist_ws_ros2}"
: "${SPOT_IMAGE:=spot:dev}"
: "${SPOT_SLAM_IMAGE:=spot_lio_sam:dev}"
: "${SPOT_ROS_DOMAIN_ID:=0}"

# Odometry backend selection:
# Options: native | superodometry | fast_livo2 | ekf
: "${SPOT_ODOMETRY_BACKEND:=native}"

DEPLOY_ENV_KEYS="
  ROBOT_REPO SPOT_WORKSPACE SPOT_IMAGE SPOT_SLAM_IMAGE SPOT_ROS_DOMAIN_ID
  SPOT_ODOMETRY_BACKEND
"
