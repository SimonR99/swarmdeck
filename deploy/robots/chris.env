# Chris (Unitree G1) deployment profile.
# Sourced by scripts/deploy for Chris on 192.168.1.37 (user unitree).

: "${DEPLOY_SSH_HOST:=chris}"
: "${DEPLOY_REMOTE_REPO:=/home/unitree/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-chris.yml}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-chris-adapter swarmdeck-chris-media}"
: "${DEPLOY_ROBOT_ID:=chris_0}"

: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${CHRIS_WORKSPACE:=/home/unitree/workspaces}"
: "${CHRIS_ROS_IMAGE:=ros:humble}"
: "${CHRIS_ROS_DOMAIN_ID:=0}"

DEPLOY_ENV_KEYS="
  ROBOT_REPO CHRIS_WORKSPACE CHRIS_ROS_IMAGE CHRIS_ROS_DOMAIN_ID
"
