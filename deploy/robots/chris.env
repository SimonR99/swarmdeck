# Chris (Unitree G1) deployment profile.
# Sourced by scripts/deploy for Chris on 192.168.1.37 (user unitree).

: "${DEPLOY_SSH_HOST:=chris}"
: "${DEPLOY_REMOTE_REPO:=/home/unitree/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-chris.yml}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-chris-adapter swarmdeck-chris-media}"
: "${DEPLOY_ROBOT_ID:=chris_0}"

: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${CHRIS_WORKSPACE:=/home/unitree/workspaces}"
: "${CHRIS_ROS_IMAGE:=ros:humble}"
: "${CHRIS_ROS_DOMAIN_ID:=0}"
: "${CHRIS_INTERFACE:=eth0}"
: "${CHRIS_ROS_WORKSPACE:=/home/unitree/workspaces/unitree_g1_ros2}"
: "${CHRIS_NATIVE_LOG:=/tmp/swarmdeck-chris-g1-bridge.log}"

# The ROS 2 Humble containers own the camera and SwarmDeck adapter. The
# installed Foxy/Unitree bridge on Chris owns locomotion, odometry, state, and
# TF, so it must be started on the robot host after Compose is refreshed.
: "${DEPLOY_OPERATOR_UP_SCRIPT:=scripts/chris-up}"
: "${DEPLOY_OPERATOR_UP_KEYS:=
  DEPLOY_REMOTE_REPO DEPLOY_COMPOSE_FILE DEPLOY_ROBOT_ID
  BACKEND_HOST BACKEND_PORT
  CHRIS_WORKSPACE CHRIS_ROS_DOMAIN_ID CHRIS_INTERFACE CHRIS_ROS_WORKSPACE
  CHRIS_NATIVE_LOG CHRIS_NATIVE_RESET CHRIS_CONTAINER_RESET
}"

DEPLOY_ENV_KEYS="
  ROBOT_REPO CHRIS_WORKSPACE CHRIS_ROS_IMAGE CHRIS_ROS_DOMAIN_ID
  CHRIS_INTERFACE CHRIS_ROS_WORKSPACE CHRIS_NATIVE_LOG
"
