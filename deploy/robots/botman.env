# Botman deployment profile. These are the current coarse mount estimates;
# replace them with measured values when available. Operator environment values
# still take precedence for a one-off calibration.

: "${DEPLOY_SSH_HOST:=botman@192.168.1.49}"
: "${DEPLOY_REMOTE_REPO:=/ssd/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-botman.yml}"
# Only containers that bind-mount the repo belong here: deploy-verify asserts
# each one mounts $DEPLOY_REMOTE_REPO, and the static_transform_publisher
# services deliberately mount nothing, so listing them failed every deploy
# ("source mount is '' (expected '/ssd/swarmdeck')") while the stack was
# in fact healthy.
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-botman-adapter swarmdeck-botman-media swarmdeck-botman-vectornav}"
: "${DEPLOY_ROBOT_ID:=botman_0}"

: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${BOTMAN_WORKSPACE:=/ssd/mist_ws}"
: "${BOTMAN_ROS_DOMAIN_ID:=17}"

# Translation is from os_lidar to oak-d-base-frame: x forward, y left, z up.
# MEASURED 2026-08-27 by scripts/calibration/run_botman_calibration.py from 5
# poses of the Spot ChArUco panel (per-plane residual <= 1.6 mm, board-normal
# misalignment 0.2-1.1 deg), then rotated into the frame this publisher uses.
#
# PARENT FRAME IS botman_base_link, NOT RAW os_lidar. The calibration measures
# against /ouster/points, which is stamped os_lidar, and raw os_lidar is yawed
# pi from the physical-forward base frame (the same pi that
# botman.launch.py's botman_base_to_scan applies). The numbers below are the
# measured transform composed with that pi, so they are what
# oak_mount_tf's --frame-id botman_base_link expects. Measured against raw
# os_lidar the same transform reads x -0.089, y 0.010, yaw +1.5739.
#
# In this frame the camera is 8.9 cm AHEAD of the lidar and 28.4 cm below it,
# which agrees with a tape measure of the lidar-to-camera offset (10.5 cm) and
# with the lidar sitting 30-35 cm above the robot's top plane.
#
# CAVEAT ON X: the solve used a 112.5 mm chequer square, derived from the
# panel's documented 118.5 x 50 cm outer size rather than measured directly.
# All five boards faced the robot, so square size and X are nearly degenerate
# (~1.7 cm of X per 1% of square size). Rotation and Z are unaffected by it.
#
# CAVEAT ON Z: every board normal was near-horizontal, so Z is the least
# constrained axis; two runs differed by 73 mm there. Lean the board back
# steeply for a capture or two and re-run to tighten it.
: "${BOTMAN_OAK_X:=0.089}"
: "${BOTMAN_OAK_Y:=-0.010}"
: "${BOTMAN_OAK_Z:=-0.284}"
: "${BOTMAN_OAK_ROLL:=-1.5504}"
: "${BOTMAN_OAK_PITCH:=0.0023}"
: "${BOTMAN_OAK_YAW:=-1.5677}"

# os_sensor mount on the mast, parent botman_base_link. TAPE MEASURED
# 2026-08-31: os_lidar is 0.28 m above base_link and 0.16 m forward; the factory
# os_sensor -> os_lidar edge is +0.036 m, which puts os_sensor at 0.244 m.
# os_sensor is forward-aligned with the chassis, so the rotation is identity;
# only os_lidar carries the pi yaw.
: "${BOTMAN_OUSTER_X:=0.16}"
: "${BOTMAN_OUSTER_Y:=0.0}"
: "${BOTMAN_OUSTER_Z:=0.244}"

# VN-100 mount, parent os_lidar. Rotation and X/Y MEASURED 2026-08-31 with
# scripts/calibration/calibrate_imu_to_imu.py (gyro pair for the rotation,
# accelerometer pair for the offset, over a 0.6 rad/s spin).
#
# Z is a calibration result as well. calibrate_imu_to_imu.py rejects a yaw
# spin precisely because it would leave z unobservable, and asks for rotation
# about non-vertical axes instead (press a front corner ~5 times, a side
# corner ~5 times, lift a side). Driven that way across the three-IMU set
# (OAK-D, Ouster, VN-100), the accelerometer pair resolves the vertical
# component; the camera-lidar leg of the session used the ChArUco panel.
#
# It remains the least-constrained component: the recorded excitation was
# singular values [16.75, 10.58, 0.77], so the third axis saw far less motion
# than the other two. Measured, but with the widest error bar of the three.
: "${BOTMAN_VECTORNAV_X:=0.0010}"
: "${BOTMAN_VECTORNAV_Y:=0.0608}"
: "${BOTMAN_VECTORNAV_Z:=-0.284}"
: "${BOTMAN_VECTORNAV_QX:=-0.008202}"
: "${BOTMAN_VECTORNAV_QY:=0.002840}"
: "${BOTMAN_VECTORNAV_QZ:=-0.722461}"
: "${BOTMAN_VECTORNAV_QW:=0.691357}"

# SuperOdometry config pair. The VN-100 is quieter than the Ouster's internal
# IMU and SuperOdometry is IMU-first, so the IMU sets the floor on odometry
# quality. The mounting rotation was measured 2026-08-27 with
# scripts/calibration/calibrate_imu_to_imu.py: os_lidar -> vectornav is a
# -92.52 deg yaw, which neither identity nor 180 deg would have got right.
#
# To fall back to the Ouster IMU (factory-exact extrinsic, no estimation),
# override the pair rather than editing these defaults:
#   BOTMAN_SUPERODOM_CONFIG=botman_superodom_ouster.yaml
#   BOTMAN_SUPERODOM_CALIB=botman_superodom_ouster_calibration.yaml
# Odometry backend selection:
# Options: superodometry | fast_livo2 | ekf | native
: "${BOTMAN_ODOMETRY_BACKEND:=superodometry}"
: "${BOTMAN_SUPERODOM_CONFIG:=botman_superodom.yaml}"
: "${BOTMAN_SUPERODOM_CALIB:=botman_superodom_calibration.yaml}"

# CAN interface for bunker_base (default can0 on Botman).
: "${BOTMAN_CAN_INTERFACE:=can0}"

DEPLOY_REQUIRED_VARS="
  BOTMAN_OAK_X BOTMAN_OAK_Y BOTMAN_OAK_Z
  BOTMAN_OAK_ROLL BOTMAN_OAK_PITCH BOTMAN_OAK_YAW
"
DEPLOY_ENV_KEYS="
  ROBOT_REPO BOTMAN_WORKSPACE BOTMAN_ROS_DOMAIN_ID
  BOTMAN_CAN_INTERFACE
  BOTMAN_OAK_X BOTMAN_OAK_Y BOTMAN_OAK_Z
  BOTMAN_OAK_ROLL BOTMAN_OAK_PITCH BOTMAN_OAK_YAW BOTMAN_OAK_PARAMS
  BOTMAN_ODOMETRY_BACKEND BOTMAN_SUPERODOM_CONFIG BOTMAN_SUPERODOM_CALIB
  BOTMAN_OUSTER_X BOTMAN_OUSTER_Y BOTMAN_OUSTER_Z
  BOTMAN_VECTORNAV_X BOTMAN_VECTORNAV_Y BOTMAN_VECTORNAV_Z
  BOTMAN_VECTORNAV_QX BOTMAN_VECTORNAV_QY BOTMAN_VECTORNAV_QZ BOTMAN_VECTORNAV_QW
"
