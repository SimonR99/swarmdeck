# Scout/TARS deployment profile. Scout's native ROS 1 graph is started by the
# operator-side scripts/scout-up helper after the Compose images are built.

: "${DEPLOY_SSH_HOST:=scout}"
: "${DEPLOY_REMOTE_REPO:=/ssd/swarmdeck}"
: "${DEPLOY_COMPOSE_FILE:=deploy/compose/docker-compose.robot-ros1.yml}"
: "${DEPLOY_MODE:=operator-script}"
: "${DEPLOY_OPERATOR_UP_SCRIPT:=scripts/scout-up}"
: "${DEPLOY_OPERATOR_UP_KEYS:=SCOUT_HOST SCOUT_REPO SCOUT_CATKIN_WS SCOUT_MIST_WS ROBOT_ID ROBOT_IP BACKEND_HOST BACKEND_PORT ROBOT_CONFIG ROBOT_REPO OUSTER_HOST_NAME CAMERA_TOPIC VIDEO_BITRATE_KBPS VIDEO_FPS}"
: "${DEPLOY_CHECK_CONTAINERS:=swarmdeck-adapter swarmdeck-media}"

: "${SCOUT_HOST:=$DEPLOY_SSH_HOST}"
: "${SCOUT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${SCOUT_CATKIN_WS:=/ssd/catkin_ws}"
: "${SCOUT_MIST_WS:=/ssd/mist_ws}"
: "${ROBOT_ID:=tars_0}"
: "${ROBOT_IP:=192.168.1.230}"
: "${BACKEND_HOST:=192.168.1.161}"
: "${BACKEND_PORT:=8080}"
: "${OUSTER_HOST_NAME:=os-992039000794.local}"
: "${CAMERA_TOPIC:=/d400_arm/color/image_raw/compressed}"
: "${ROBOT_CONFIG:=adapters/adapter_ros1/config/scout_mini.yaml}"
: "${ROBOT_REPO:=$DEPLOY_REMOTE_REPO}"
: "${VIDEO_BITRATE_KBPS:=700}"
: "${VIDEO_FPS:=10}"

DEPLOY_ENV_KEYS="
  ROBOT_ID ROBOT_IP BACKEND_HOST BACKEND_PORT ROBOT_CONFIG ROBOT_REPO
  SCOUT_CATKIN_WS SCOUT_MIST_WS
  OUSTER_HOST_NAME CAMERA_TOPIC VIDEO_BITRATE_KBPS VIDEO_FPS
  MEDIA_HOST MEDIA_RTSP_PORT
"
