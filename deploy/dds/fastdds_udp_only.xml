<?xml version="1.0" encoding="UTF-8"?>
<!--
  UDP-only transport for short-lived ROS health probes. A probe may need SIGKILL
  when native DDS initialization stalls; it must not leave a partly initialized
  host SHM object that blocks the next participant. Long-lived cloud consumers
  use fastdds_large_data.xml for efficient local shared-memory delivery.
  XML works with the Fast DDS versions in the ROS 2 Humble images.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>swarmdeck_udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="swarmdeck_udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>swarmdeck_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
