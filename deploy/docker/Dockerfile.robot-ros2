FROM ros:humble-ros-base

# Hardware remains on Humble. Its signed snapshot is independent of Jazzy's
# navigation qualification; no historical Docker cache is needed.
COPY deploy/docker/use-ros-snapshot.sh deploy/docker/ros-snapshot-key.asc /tmp/
RUN bash /tmp/use-ros-snapshot.sh

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gir1.2-gstreamer-1.0 \
      gstreamer1.0-plugins-base \
      gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad \
      gstreamer1.0-plugins-ugly \
      gstreamer1.0-rtsp \
      gstreamer1.0-tools \
      python3-gi \
      python3-numpy \
      python3-opencv \
      python3-pip \
      python3-venv \
      python3-yaml \
      python3-colcon-common-extensions \
      git \
      ros-humble-geometry-msgs \
      ros-humble-nav-msgs \
      ros-humble-nav2-msgs \
      ros-humble-sensor-msgs \
      ros-humble-tf2-ros \
      ros-humble-realsense2-camera \
      ros-humble-rosidl-default-generators \
    && pip3 install --no-cache-dir websockets==10.4 \
    && rm -rf /var/lib/apt/lists/*

# Declared just before its use so a pin change does not invalidate the apt
# layers above.
ARG MGG_REV=bb454037859cbb21b9bebaa34b6ba3c530b65c31
COPY deploy/docker/build-mgg-msgs.sh /tmp/build-mgg-msgs.sh
RUN bash /tmp/build-mgg-msgs.sh "$MGG_REV"
ENV AMENT_PREFIX_PATH="/opt/swarmdeck-mgg-msgs:${AMENT_PREFIX_PATH}" \
    LD_LIBRARY_PATH="/opt/swarmdeck-mgg-msgs/lib:${LD_LIBRARY_PATH}" \
    PYTHONPATH="/opt/swarmdeck-mgg-msgs/lib/python3.10/site-packages:${PYTHONPATH}"

WORKDIR /app
COPY adapters /app/adapters
COPY autonomy /app/autonomy
# Jammy's system pip leaks apt setuptools into PEP 517 build isolation. Build
# with a temporary venv so the pyproject backend wins without replacing ROS's
# system Python tooling, then install only the protocol wheel into the runtime.
RUN python3 -m venv /tmp/protocol-build \
    && /tmp/protocol-build/bin/pip wheel --no-cache-dir --no-deps \
         --wheel-dir /tmp/protocol-build/wheels /app/adapters/protocol \
    && pip3 install --no-cache-dir /tmp/protocol-build/wheels/swarmdeck_protocol-*.whl \
    && python3 -I -c "import swarmdeck_protocol" \
    && rm -rf /tmp/protocol-build
ENV PYTHONPATH="/app/adapters/protocol:/app:/app/swarmdeck/adapters/protocol:/app/swarmdeck:${PYTHONPATH:-}"

CMD ["python3", "/app/adapters/adapter_ros2/adapter_ros2.py", "--help"]
