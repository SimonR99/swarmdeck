ARG ULTRALYTICS_IMAGE=ultralytics/ultralytics:8.4.14-cpu
FROM ${ULTRALYTICS_IMAGE}

# YOLOE uses MobileCLIP only while binding the text prompt. Pin the exact
# upstream revision validated on Botman's JetPack 6 image.
ARG ULTRALYTICS_CLIP_REF=488e81a6711eea7346872b46ea928b367da8889d
RUN python3 -m pip install --no-cache-dir \
      "git+https://github.com/ultralytics/CLIP.git@${ULTRALYTICS_CLIP_REF}"

# Prompts are no longer an image setting: the classes, their wording and their
# score floors live together in adapters/perception/catalog.py, so that one
# table stays the single description of what this detector recognises.
ENV PYTHONUNBUFFERED=1 \
    YOLO_CONFIG_DIR=/models/config \
    SWARMDECK_YOLOE_MODEL=yoloe-26n-seg.pt

WORKDIR /app
COPY adapters /app/adapters
RUN mkdir -p /models
WORKDIR /models

# The timeout is generous on purpose. This asks "is the server alive and
# serving", not "is it fast", and the answer arrives behind whatever inference
# is already in flight. Once the container is CPU-capped (see the `cpus` limit
# on the service in docker-compose.yml) a 3s/2s budget starts failing on a
# detector that is answering every real /detect request with a 200: the
# container is marked unhealthy, and `depends_on: service_healthy` then refuses
# to start the simulation at all.
HEALTHCHECK --interval=10s --timeout=15s --retries=12 --start-period=120s \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=12).read()"

ENTRYPOINT ["python3", "/app/adapters/perception/yoloe_server.py"]
