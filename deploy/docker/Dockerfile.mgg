FROM ros:jazzy-perception
SHELL ["/bin/bash", "-c"]
# Match ROS interface generators and dependency versions in contract-only images.
COPY deploy/docker/use-ros-snapshot.sh deploy/docker/ros-snapshot-key.asc /tmp/
RUN bash /tmp/use-ros-snapshot.sh
# Pin the planner: the ros2 branch of MGGPlanner.
ARG MGG_REV=46e3e8e005390433d1ec5baa969d1e15d9e0cdf8
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git python3-colcon-common-extensions python3-yaml \
    libeigen3-dev libboost-dev libyaml-cpp-dev libssl-dev nlohmann-json3-dev ros-jazzy-octomap \
    ros-jazzy-octomap-msgs ros-jazzy-octomap-ros ros-jazzy-tf2-ros ros-jazzy-nav2-msgs \
    ros-jazzy-rclpy \
    ros-jazzy-tf2-geometry-msgs ros-jazzy-rosidl-default-generators \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --branch ros2 https://github.com/MISTLab/MGGPlanner.git /opt/mgg \
    && git -C /opt/mgg checkout "$MGG_REV"
WORKDIR /opt/mgg/ros2
RUN source /opt/ros/jazzy/setup.bash && \
    CMAKE_BUILD_PARALLEL_LEVEL=2 colcon build --packages-up-to mgg_ros mgg_pci \
    --executor sequential --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
COPY deploy/mgg /app/deploy/mgg
COPY adapters/protocol /app/adapters/protocol
COPY swarmdeck_ros/src/swarmdeck_sim /app/swarmdeck_ros/src/swarmdeck_sim
COPY configs /app/configs
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && source /opt/mgg/ros2/install/setup.bash && exec python3 /app/deploy/mgg/supervisor.py"]
