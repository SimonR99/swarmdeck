# Native MOLA map bridge and persistent runtime build/smoke test.
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.mapping -t swarmdeck-mapping:local .
FROM ros:jazzy-ros-base AS mapping-contracts

SHELL ["/bin/bash", "-c"]

ARG MOLA_VERSION=2.9.0
# Cache anchor, not the pin. The ROS apt repository no longer serves MOLA
# 2.9.0 (only 3.2.0 remains), so the apt layer below can only be reused from
# Docker's cache, and BuildKit keys that layer on every ARG declared above
# it. This declaration reproduces the scope the cached layer was built with;
# the real MGG pin is declared again just before its use. Changing this value
# forces a fresh apt install, which fails until MOLA is upgraded or mirrored.
ARG MGG_REV=902e868b1d7ec70be8ccfd0351b0d0a94e07c2ca
ENV DEBIAN_FRONTEND=noninteractive
ENV CMAKE_BUILD_PARALLEL_LEVEL=2

# MOLA packages come from the ROS Jazzy repository already configured by the
# base image. The version prefix prevents an unnoticed major/minor API update;
# the Debian release suffix may change for a rebuild of the same upstream tag.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git python3-colcon-common-extensions python3-numpy \
      libssl-dev nlohmann-json3-dev \
      ros-jazzy-rosidl-default-generators \
      "ros-jazzy-mola=${MOLA_VERSION}-*" \
      "ros-jazzy-mola-kernel=${MOLA_VERSION}-*" \
      "ros-jazzy-mola-metric-maps=${MOLA_VERSION}-*" \
      "ros-jazzy-mola-launcher=${MOLA_VERSION}-*" \
    && rm -rf /var/lib/apt/lists/*

# Build only MGG's small generated wire-contract package. The mapping runtime
# does not build or link the planner itself.
# Declared just before its use: an ARG invalidates the cache of every RUN
# that follows it, and the apt layers above must stay cached because the ROS
# repository no longer serves the pinned MOLA release.
ARG MGG_REV=004c517b90a0295940d8f851a4922138d63b0e53
COPY deploy/docker/build-mgg-msgs.sh /tmp/build-mgg-msgs.sh
RUN bash /tmp/build-mgg-msgs.sh "$MGG_REV" \
    && rm -rf /tmp/mgg-msgs-source

FROM mapping-contracts AS mapping-runtime

ENV LD_LIBRARY_PATH=/mapping_ws/install/swarmdeck_mapping/lib
ENV MOLA_MODULES_LIB_PATH=/mapping_ws/install/swarmdeck_mola/lib

WORKDIR /mapping_ws
COPY swarmdeck_ros/src/swarmdeck_mapping src/swarmdeck_mapping
COPY swarmdeck_ros/src/swarmdeck_mola src/swarmdeck_mola
COPY autonomy /opt/swarmdeck/autonomy
# Keep the worker's package import path available to deployment fixtures and
# service wrappers. The executable copies below remain the installed CLI entry
# points used by the runtime image.
COPY deploy/autonomy/mola_worker.py /opt/swarmdeck/deploy/autonomy/mola_worker.py
COPY deploy/autonomy/mola_process.py /opt/swarmdeck/deploy/autonomy/mola_process.py
COPY deploy/autonomy/mola_worker.py /usr/local/bin/swarmdeck-mola-worker
COPY deploy/autonomy/mola_process.py /usr/local/bin/mola_process.py
COPY deploy/autonomy/indexed_map_server.py /opt/swarmdeck/deploy/autonomy/indexed_map_server.py
COPY deploy/autonomy/run_indexed_map_server.sh /usr/local/bin/swarmdeck-indexed-map-server
COPY tests/deployment/mola_jsonl_smoke.py /usr/local/bin/mola-jsonl-smoke.py
COPY tests/deployment/mola_launcher_smoke.py /usr/local/bin/mola-launcher-smoke.py
COPY tests/deployment/mola_planner_acceptance.py /usr/local/bin/mola-planner-acceptance.py

RUN chmod 0755 /usr/local/bin/swarmdeck-mola-worker /usr/local/bin/mola_process.py \
    /usr/local/bin/swarmdeck-indexed-map-server /usr/local/bin/mola-jsonl-smoke.py \
    /usr/local/bin/mola-launcher-smoke.py /usr/local/bin/mola-planner-acceptance.py

RUN source /opt/ros/jazzy/setup.bash \
    && colcon build --packages-select swarmdeck_mapping swarmdeck_mola \
         --cmake-args -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_TESTING=ON \
    && test -x install/swarmdeck_mapping/bin/swarmdeck-mola-import \
    && ctest --test-dir build/swarmdeck_mapping --output-on-failure \
    && ctest --test-dir build/swarmdeck_mola --output-on-failure

# Cross the Python/native boundary with the actual canonical snapshot and chunk
# format, then ensure MRPT serialization emits a nonempty MOLA metric map.
RUN PYTHONPATH=/opt/swarmdeck python3 src/swarmdeck_mapping/test/make_fixture.py /tmp/map-fixture \
    && source /opt/ros/jazzy/setup.bash \
    && /mapping_ws/install/swarmdeck_mapping/bin/swarmdeck-mola-import \
         /tmp/map-fixture/snapshot.json \
         /tmp/map-fixture/chunks /tmp/smoke.metricmap \
    && test -s /tmp/smoke.metricmap

# The same native snapshot consumer must accept colored peer submaps while
# retaining only their geometry for navigation.
RUN PYTHONPATH=/opt/swarmdeck python3 src/swarmdeck_mapping/test/make_fixture.py /tmp/color-fixture --color \
    && source /opt/ros/jazzy/setup.bash \
    && /mapping_ws/install/swarmdeck_mapping/bin/swarmdeck-mola-import \
         /tmp/color-fixture/snapshot.json \
         /tmp/color-fixture/chunks /tmp/color.metricmap \
    && test -s /tmp/color.metricmap

# Drive ``swarmdeck-mola-import --serve`` through one persistent JSONL process.
# The script has per-read deadlines and the outer timeout bounds image build
# time if the native process hangs before ready or response.
# Create this fixture in the same layer: overlayfs cannot rename a directory
# inherited from an earlier layer when the smoke hides its geometry chunks.
RUN PYTHONPATH=/opt/swarmdeck python3 src/swarmdeck_mapping/test/make_fixture.py /tmp/protocol-fixture \
    && source /opt/ros/jazzy/setup.bash \
    && timeout 45s python3 /usr/local/bin/mola-jsonl-smoke.py --root /tmp/protocol-fixture

# Verify the loadable MOLA module discovers its factory and MapSource service
# from the installed module directory using a fresh coherent fixture.
RUN PYTHONPATH=/opt/swarmdeck python3 src/swarmdeck_mapping/test/make_fixture.py /tmp/module-fixture \
    && source /opt/ros/jazzy/setup.bash \
    && timeout 30s build/swarmdeck_mola/bin/test_mola_module \
         /mapping_ws/install/swarmdeck_mola/lib /tmp/module-fixture

# Exercise the actual MOLA launcher with the installed module configuration.
# The smoke injects an artifact output so it verifies scheduling and framework
# publication while keeping the checked-in config's artifact key optional.
RUN PYTHONPATH=/opt/swarmdeck python3 src/swarmdeck_mapping/test/make_fixture.py /tmp/launcher-fixture \
    && source /opt/ros/jazzy/setup.bash \
    && timeout 15s python3 /usr/local/bin/mola-launcher-smoke.py \
         --fixture /tmp/launcher-fixture \
         --config /mapping_ws/install/swarmdeck_mola/share/swarmdeck_mola/config/external-map.yaml \
         --timeout 10

# Exercise the native SDMGRID1 planner artifact through the deployment worker
# and MOLA directory provider. This is a bounded, no-ROS, no-motion fixture.
RUN source /opt/ros/jazzy/setup.bash \
    && timeout 45s env PYTHONPATH=/opt/swarmdeck \
         python3 /usr/local/bin/mola-planner-acceptance.py \
         --binary /mapping_ws/install/swarmdeck_mapping/bin/swarmdeck-mola-import

# Verify the generated MGG service contract against the actual query server.
# Both ROS processes stay on loopback in a separate domain and send no motion.
COPY tests/deployment/mola_ros_query_smoke.py /usr/local/bin/mola-ros-query-smoke.py
RUN --network=none source /opt/ros/jazzy/setup.bash \
    && source /opt/swarmdeck-mgg-msgs/local_setup.bash \
    && timeout 45s env PYTHONPATH=/opt/swarmdeck:${PYTHONPATH} \
         python3 /usr/local/bin/mola-ros-query-smoke.py

CMD ["bash"]
