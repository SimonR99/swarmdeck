<?xml version="1.0"?>
<package format="3">
  <name>fast_livo</name>
  <version>2.0.0</version>
  <description>
    FAST-LIVO2: Fast, Direct LiDAR-Inertial-Visual Odometry (hku-mars), vendored
    via sjtuyinjie/M3DGR and ported from catkin to ament. The algorithm sources
    are unmodified; the ROS 1 API they use is provided by include/ros1_shim.h.
  </description>
  <maintainer email="swarmdeck@example.com">SwarmDeck</maintainer>
  <license>GPL-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>vikit_common</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
