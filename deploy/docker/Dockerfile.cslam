# Swarm-SLAM (MISTLab `cslam`) on ROS 2 Jazzy — the Stage 3.0 build spike.
#
#   docker build -f docker/Dockerfile.cslam -t swarmdeck-cslam:local .
#
# This exists because the riskiest thing about adopting Swarm-SLAM here is not
# the integration, it is whether it builds at all on this distro. Upstream's
# instructions are written against Foxy and validate **GTSAM 4.1.1**, while Jazzy
# ships `ros-jazzy-gtsam` 4.2.0; the lidar front end additionally needs TEASER++
# with Python bindings (but not torch, which is the image-based path only).
#
# Keeping the spike as a Dockerfile rather than a shell transcript means the
# answer is reproducible and the failure point, if any, is a build log rather
# than a memory.
#
# It deliberately does NOT extend the Gazebo image. Swarm-SLAM runs per robot —
# on the robot itself in a real deployment — so it gets its own image, and the
# adapter seam means it never has to share a ROS graph with the backend.

FROM ros:jazzy-ros-base

# Keep peer message dependencies on the same signed Jazzy snapshot as sim/MGG.
COPY deploy/docker/use-ros-snapshot.sh deploy/docker/ros-snapshot-key.asc /tmp/
RUN bash /tmp/use-ros-snapshot.sh

ARG BUILD_JOBS=4
ARG TEASER_REF=52a9c52ee7d4c838c5e8a75458c33178be5bfb70

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Swarm-SLAM's C++ front end links librtabmap and rtabmap_conversions
# (cslam/package.xml); the rest are its other declared ROS dependencies. No
# RTAB-Map SLAM or odometry node runs in this image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git \
      python3-pip python3-vcstool python3-numpy python3-scipy \
      python3-colcon-common-extensions \
      libeigen3-dev libboost-all-dev libtbb-dev pybind11-dev \
      libpcl-dev \
      ros-jazzy-gtsam ros-jazzy-nav2-msgs \
      ros-jazzy-rmw-zenoh-cpp \
      ros-jazzy-pcl-conversions \
      ros-jazzy-perception-pcl \
      ros-jazzy-tf2-ros \
      ros-jazzy-rtabmap ros-jazzy-rtabmap-msgs ros-jazzy-rtabmap-conversions \
      ros-jazzy-cv-bridge ros-jazzy-image-transport ros-jazzy-image-geometry \
      ros-jazzy-laser-geometry ros-jazzy-message-filters ros-jazzy-pluginlib \
      ros-jazzy-pcl-ros ros-jazzy-diagnostic-msgs ros-jazzy-stereo-msgs \
      ros-jazzy-tf2-eigen \
    && rm -rf /var/lib/apt/lists/*

# TEASER++ with Python bindings — the lidar registration back end. Built before
# the workspace so a failure here is unambiguous.
# TEASER++ and its Python bindings, which cslam's lidar path needs.
#
# The bindings are the fiddly part, and every way of getting them wrong fails
# silently at runtime rather than at build time:
#
# * `BUILD_PYTHON_BINDINGS=ON` is the real option. There is no
#   `TEASERPP_PYTHON_VERSION` in this version, and passing it instead simply
#   leaves the bindings off — `make teaserpp_python` then reports "No rule to
#   make target", which reads like a missing dependency rather than a typo'd
#   flag. `pybind11-dev` must be present for the `find_package(pybind11
#   REQUIRED)` in `python/CMakeLists.txt`.
# * `cmake --install` does NOT install them. The module is built to
#   `build/python/teaserpp_python/_teaserpp.cpython-*.so`, and the `__init__.py`
#   that turns it into an importable package lives in the SOURCE tree. Both
#   halves have to be copied; neither alone imports.
# * No `#` comments inside a continued RUN: Docker hands them to the shell,
#   where `#` comments out the rest of the line and truncates the chain.
#
# Missing bindings still produce an image where cslam compiles and every node
# starts, and the lidar loop-closure path then dies on `import teaserpp_python`
# the first time two robots have something to verify. Both the import and the
# solver symbol are asserted here so that cannot ship.
WORKDIR /opt
RUN git clone https://github.com/MIT-SPARK/TEASER-plusplus.git \
    && git -C TEASER-plusplus checkout "${TEASER_REF}" \
    && cmake -S TEASER-plusplus -B TEASER-plusplus/build \
         -DCMAKE_BUILD_TYPE=Release \
         -DBUILD_TEASER_FPFH=ON \
         -DBUILD_TESTING=OFF \
         -DBUILD_PYTHON_BINDINGS=ON \
    && cmake --build TEASER-plusplus/build -j"${BUILD_JOBS}" \
    && cmake --install TEASER-plusplus/build \
    && ldconfig \
    && SP="$(python3 -c 'import site; print(site.getsitepackages()[0])')" \
    && cp -r /opt/TEASER-plusplus/python/teaserpp_python "$SP/" \
    && cp /opt/TEASER-plusplus/build/python/teaserpp_python/_teaserpp*.so \
          "$SP/teaserpp_python/" \
    && python3 -c "import teaserpp_python; assert hasattr(teaserpp_python, 'RobustRegistrationSolver'); print('teaserpp_python OK')"

WORKDIR /cslam_ws
# Pin every repository; the upstream umbrella file follows moving branches.
COPY deploy/cslam/upstream.repos /tmp/cslam.repos
RUN mkdir -p src && vcs import src < /tmp/cslam.repos
RUN git clone https://github.com/MISTLab/Swarm-SLAM.git /opt/Swarm-SLAM \
    && git -C /opt/Swarm-SLAM checkout af17c4b71432f750571ea699a0beccfbe9004872

# Install the repo's OWN requirements.txt rather than a guessed subset. Getting
# this wrong does not fail the build: colcon compiles cslam regardless, and the
# Python nodes then die on `import open3d` / `import networkx` the moment they
# are launched, while the C++ pose_graph_manager starts perfectly and makes the
# stack look healthy.
#
# torch and torchvision are dropped deliberately. They are ~2.5 GB and only the
# image-based global descriptor (CosPlace) needs them; the lidar front end uses
# Scan Context, which is why upstream documents lidar mode as torch-free. Put
# them back if this fleet ever runs the stereo or RGB-D path.
#
# `--ignore-installed psutil` first: open3d pulls a newer psutil, and the base
# image's copy came from apt with no RECORD file, so pip refuses with "Cannot
# uninstall psutil ... installed by debian" and the whole requirements install
# aborts. Installing a pip-managed copy alongside satisfies the resolver without
# pip having to remove a distro package.
RUN pip3 install --break-system-packages --no-cache-dir --ignore-installed psutil \
    && sed -e '/^torch/d' -e '/^torchvision/d' /opt/Swarm-SLAM/requirements.txt > /tmp/req.txt \
    && pip3 install --break-system-packages --no-cache-dir -r /tmp/req.txt

COPY deploy/patches/cslam-solution-version.patch /tmp/cslam-solution-version.patch
COPY deploy/patches/cslam-keyframe-readiness.patch /tmp/cslam-keyframe-readiness.patch
COPY deploy/patches/cslam-registration-budget.patch /tmp/cslam-registration-budget.patch
# The overlap gate depends on both of the patches above: it reads the refinement
# that registration-budget bounded, and it adds a parameter the handler patched
# by keyframe-readiness declares. Apply it last.
COPY deploy/patches/cslam-registration-overlap.patch /tmp/cslam-registration-overlap.patch
# A stationary robot otherwise never re-observes a scene that changed in front
# of it. Touches only the lidar handler, after the overlap patch that edits it.
COPY deploy/patches/cslam-scene-change-keyframe.patch /tmp/cslam-scene-change-keyframe.patch
# Swarm-SLAM's selector does not treat a zero budget as off; this guard does.
COPY deploy/patches/cslam-inter-robot-switch.patch /tmp/cslam-inter-robot-switch.patch
# The budget rations candidates per period, not closures per pair: a linked
# pair kept being re-registered (707 closures per peer in 20 minutes). The cap
# hunks sit right after the switch's early return, so it applies after it.
COPY deploy/patches/cslam-inter-robot-pair-cap.patch /tmp/cslam-inter-robot-pair-cap.patch
# Inter-robot closures carry a fraction of a degree of pitch and roll error
# and the optimizer rotates a whole robot's chain to absorb it (0.7 to 1.5
# degrees measured on 2026-09-20), which puts the shared floor 0.5 m off at
# 20 m. An attitude prior on every pose keeps the solution upright; the
# sigma is backend.upright_prior_sigma_rad, off at zero.
COPY deploy/patches/cslam-upright-prior.patch /tmp/cslam-upright-prior.patch
# Per-robot epoch fencing extends the versioned wire contract after all prior
# graph and loop-closure changes.
COPY deploy/patches/cslam-map-epoch.patch /tmp/cslam-map-epoch.patch
COPY deploy/patches/cslam-inter-robot-descriptors.patch /tmp/cslam-inter-robot-descriptors.patch
COPY deploy/patches/cslam-closure-consistency.patch /tmp/cslam-closure-consistency.patch
RUN cd src && git apply --check /tmp/cslam-solution-version.patch \
    && git apply /tmp/cslam-solution-version.patch \
    && git apply /tmp/cslam-keyframe-readiness.patch \
    && git apply /tmp/cslam-registration-budget.patch \
    && git apply /tmp/cslam-registration-overlap.patch \
    && git apply /tmp/cslam-scene-change-keyframe.patch \
    && git apply /tmp/cslam-inter-robot-switch.patch \
    && git apply /tmp/cslam-inter-robot-pair-cap.patch \
    && git apply /tmp/cslam-upright-prior.patch \
    && git apply /tmp/cslam-map-epoch.patch \
    && git apply /tmp/cslam-inter-robot-descriptors.patch \
    && git apply /tmp/cslam-closure-consistency.patch

# Native compilation verifies the versioned peer message contract.
RUN . /opt/ros/jazzy/setup.sh \
    && MAKEFLAGS="-j${BUILD_JOBS}" colcon build --symlink-install --parallel-workers 2 \
         --cmake-args -DCMAKE_BUILD_TYPE=Release \
         --packages-skip cslam_experiments

# SwarmDeck's own wiring, built on top of the cslam workspace. Last layer, so
# editing the launch/config rebuilds in seconds rather than re-running apt.
COPY swarmdeck_ros/src/swarmdeck_cslam /cslam_ws/src/swarmdeck_cslam
COPY adapters /app/adapters
COPY autonomy /app/autonomy
COPY deploy/autonomy /app/deploy/autonomy
ENV PYTHONPATH=/app
RUN . /opt/ros/jazzy/setup.sh \
    && . /cslam_ws/install/setup.sh \
    && colcon build --symlink-install --packages-select swarmdeck_cslam

CMD ["bash"]
