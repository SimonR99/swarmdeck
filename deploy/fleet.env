# Fleet-wide robot deployment settings.
#
# This file is sourced before deploy/robots/<name>.env. Set the operator/server
# address here once for every robot, or override any value for one invocation:
#   BACKEND_HOST=192.168.1.10 make deploy ROBOT=scout

: "${BACKEND_HOST:=192.168.1.161}"
: "${BACKEND_PORT:=8080}"
: "${MEDIA_RTSP_PORT:=8554}"
: "${VIDEO_BITRATE_KBPS:=700}"
: "${VIDEO_FPS:=10}"
: "${VIDEO_WIDTH:=640}"
: "${VIDEO_HEIGHT:=480}"

DEPLOY_GLOBAL_ENV_KEYS="
  BACKEND_HOST BACKEND_PORT MEDIA_RTSP_PORT
  VIDEO_BITRATE_KBPS VIDEO_FPS VIDEO_WIDTH VIDEO_HEIGHT
"
